/*
 * Based on CVE-2022-0185 and the actual fix found at the following link
 * https://git.kernel.org/pub/scm/linux/kernel/git/torvalds/linux.git/commit/?id=722d94847de2
 * The vulnerability consists in a buffer overflow which could
 * be used to carry out privilege escalation form an unprivileged user
 */

 class FsContext {
     pageSize;
     bufferSize;
     legacyData;

     ~FsContext() {
         this.pageSize = 4096;
         this.bufferSize = 0;
         this.legacyData = "";
     }

     appendParam(data, len) {
         def tmp = this.pageSize - 2 - this.bufferSize;   // if bufferSize becomes larger than pageSize the subtraction
         if (len > tmp) {                                 // underflows and becomes a really big positive number
             return -1;
         }
         this.copy(data, len);
         this.bufferSize = this.bufferSize + len;
         return 0;
     }

     appendParamFixed(data, len) {
         def tmp = this.bufferSize + len + 2;
         if (tmp > this.pageSize) {
             return -1;
         }
         this.copy(data, len);
         this.bufferSize = this.bufferSize + len;
         return 0;
     }

     copy(data, len) { // Simulated unsafe memory copy
         this.legacyData = this.legacyData + data;
     }

     corruptState() { // simulates attacker-controlled corruption
         this.bufferSize = 5000;
     }
 }


 class Test {
     bufferOverflowVulnerable() {
         def ctx = new FsContext();
         ctx.appendParam("AAAA", 4);
         ctx.corruptState();
         ctx.appendParam("BBBBBBBBBBBBBBBB", 16); // bound check bypassed
     }

     bufferOverflowFixed() {
         def ctx = new FsContext();
         ctx.appendParamFixed("AAAA", 4);
         ctx.corruptState();
         ctx.appendParamFixed("BBBBBBBBBBBBBBBB", 16);
     }
}