// This is a simulation of population growth
// When the rate is set too high, this can result in overflows
//
// 913849 -- Quinn Robertson
class population {
    population;

    ~population(){
        this.population = 10000;
    }

    growth(birth_rate, death_rate) {
        this.population = this.population + (this.population * birth_rate) - (this.population * death_rate);
    }

    main() {
        def birth_rate = 1.3;
        def death_rate = 0.01;
        def x = 0;
        while (x < 10000000) {
            x = x + 1;
            this.growth(birth_rate,death_rate);
        }
    }
}