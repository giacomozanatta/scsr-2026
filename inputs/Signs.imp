class signs {
    loop() {
        def c = 1;
        def b = 0;
           while (b < 10)
            b = b + c;
           return b;
    }

    basic() {
        def i = 2;
        def j = -10;
        def a = i + j;
        def s = i - j;
        def m = i * j;
        def d = i / j;
    }

    branches() {
        def a = 3;
        def b = 5;
        def x = 0;
        if (a > b)
               x = x * 7;
           else
               x = -7;
        def y = x / x;
    }

    zerotest() {
        def zero = 0;
        def a = 3;
        def b = 4;
        def div1 = a / zero;
        def div2 = zero / a;
        def div3 = zero / zero;
        def sub1 = a - zero;
        def sub2 = zero - a;
        def sub3 = zero - zero;
    }
}