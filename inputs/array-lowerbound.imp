class safeAccess {

	read() {
		def arr = new int[10];
		def i = 3;
		def x = arr[i];
		return x;
	}
}

class definiteUnderflow {

	read() {
		def arr = new int[10];
		def i = 0 - 1;
		def x = arr[i];
		return x;
	}
}

class possibleUnderflow {

	read(input) {
		def arr = new int[10];
		def x = arr[input];
		return x;
	}
}
