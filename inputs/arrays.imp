class Arrays {

	inBounds() {
		def arr = new int[5];
		arr[0] = 10;
		arr[1] = 11;
		arr[2] = 12;
		arr[3] = 13;
		arr[4] = 14;
		def x = arr[2]; // in bounds
		return x;
    }

	outOfBounds() {
		def a1 = new int[3];
		a1[0] = 10;
		a1[1] = 11;
		a1[2] = 12;

		def a2 = new int[2];
		a2[0] = 15;
		a2[1] = 16;

		def ne = -1;

		def x = a1[ne];
		def y = a2[2];
		def z = a2[3];

		return z;
    }
}