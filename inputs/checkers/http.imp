class http{
    func(s){
        return 0;
    }

    string_1(){
        def obvious = "http://www.dfos.com";
        this.func(obvious);
    }

    string_concat(){
        def base = "www.hi.com";
        def protocol = "https://";
        def res = strcat(protocol, base); // Only returns the first argument for some reason
        this.func(res);
    }

    string_array(){
        def arr = new string[2];
        arr[0] = "h";
        arr[1] = "t";
        //def a = "ciao";
        this.func(arr[0]);
        //this.func(a);
    }

}