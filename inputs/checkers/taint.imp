class taint{
    sink(int i)
    {
        assert i >= 0;
    }

    sink(int[3] arr)
    {
        assert arr[0] >= 0;
        assert arr[1] >= 0;
        assert arr[2] >= 0;
    }

    source_int()
    {
        return -1;
    }

    source_arr()
    {
        def arr = new int[3];
        arr[0] = -1;
        arr[1] = -2;
        arr[2] = 3;
        return arr;
    }

    sanitize(int i)
    {
        if(i < 0)
            return -i;
        return i;
    }

    sanitize(int[3] arr)
    {
        for(def i = 0; i < 3; i = i + 1)
        {
            arr[i] = this.sanitize(arr[i]);
        }
        return arr;
    }

    test1()
    {
        def y = this.source_int();
        y = this.sanitize(y);
        this.sink(y); //y clean
    }

    test2()
    {
        def y = this.source_arr();
        y = this.sanitize(y);
        this.sink(y); //y clean
    }

    test3()
    {
        def a = 3;
        def b = this.source_int();
        b = b + a;
        b = this.sanitize(b);
        this.sink(b); //b clean
    }
    
    test4()
    {
        def a = this.source_int();
        def b = 5;
        b = this.sanitize(b);
        a = a + b;
        this.sink(a); //a taint
    }

    test5()
    {
        def a = this.source_arr();
        a[0] = -4;
        a = this.sanitize(a);
        this.sink(a); //a clean
    }

    test6()
    {
        def a = this.source_arr();
        a[0] = this.source_int();
        a = this.sanitize(a);
        this.sink(a); //a clean
    }

    test7()
    {
        def a = this.source_arr();        
        a = this.sanitize(a);
        a[0] = this.source_int();
        this.sink(a); //a taint, because of a[0]
    }

    test8()
    {
        def x = this.source_int();
        if(x < 0)
        {
            x = this.sanitize(x);
        }
        else
        {
            x = 1;
        }
        this.sink(x); //x top
    }

    test9()
    {
        def a = this.source_arr();
        for(def i = 0; i < 10; i = i + 1)
        {
            a[0] = a[0] + 1;
            a = this.sanitize(a);
        }
        this.sink(a);//a clean 
    }

    test10()
    {
        def x = this.source_arr();
        def y = 10;
        for(def i = 0; i < 10; i = i + 1)
        {
            if(i%2 == 0)
            {
                x = x * y;
            }
            else
            {
                x = this.sanitize(x);
            }
        }
        this.sink(x); //x clean
    }

    test11()
    {
        def a = this.source_arr();
        def x = this.sanitize(a[0]);
        this.sink(x); // x clean
    }

    test12()
    {
        def a = this.source_arr();
        def x = a[0];
        this.sink(x); //x taint
    }

   nested_sanitizer1(int t)
   {
       def x = this.sanitize(t);
       return x;
   }

    nested_sanitizer2(int t)
    {
        return this.sanitize(t);
    }

   nested_sanitizer3(int t)
   {
       def x = 0;
       if(x > 0)
       {
           x = this.sanitize(t);
       }
       return x;
   }

    test13()
    {
        def x = this.source_int();
        def t = this.nested_sanitizer1(x);
        this.sink(t);//t clean
    }

    test14()
    {
        def x = this.source_int();
        def t = this.nested_sanitizer2(x);
        this.sink(t); //t clean
    }

    test15()
    {
        def x = this.source_int();
        def t = this.nested_sanitizer3(x);
        this.sink(t);//t top
    }

    test16()
    {
        def x = this.source_int();
        for(def i = 0; i < 100000; i = i + 1)
        {
            x = x * 1;
        }
        x = this.sanitize(x);
        this.sink(x);//x clean
    }

    test17()
    {
        def x = this.source_int();
        x = this.sanitize(x);
        for(def i = 0; i < 100000; i = i + 1)
        {
            x = x * 1;
        }        
        this.sink(x);//x clean
    }
}