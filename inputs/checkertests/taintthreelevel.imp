/*
 * Simulates a sever receiving objects that need to be deserialized.
 * This is a typical vulnerability in languages like Java that will
 * run magic methods during said operation, leading to vulnerabilities
 * of the category CWE-502
 * This means that we'll have:
 *  - "sourceSerializedObject" as the source
 *  - "sanitizeParam" as the sanitizer
 *  - "deserializePathJob" as the sink
 */


// simulated network packet carrying serialized objects
class SerializedRequest {
    ~SerializedRequest() {}

    sourceSerializedObject() {
        return "SERIALIZED: ../../../../../tmp/totallysafe.sh";
    }
}


class Sanitizer {
    ~Sanitizer() {}

    sanitizeParam(param) {
        return param;
    }

    sanitizeJob(thing) {
        thing.path = this.sanitizeParam(thing.path);
        return thing;
    }
}


// simulated deserialized object
class Job {
    path;

    ~Job() {}

    setPath(path) {
        this.path = path;
    }

    getPath() {
        return this.path;
    }
}


class ObjectDeserializer {

    ~ObjectDeserializer() {}

    deserializePathJob(data) {
        def job = new Job();
        job.setPath(data);
        return job;
    }
}


class FileSystem {
    ~FileSystem() {}

    readFile(path) {
        return;
    }
}


class ProcessExecutor {
    ~ProcessExecutor() {}

    execute(cmd) {
        return;
    }
}


class JavaServerFlawed {
    deserializer;
    sanitizer;
    fs;
    executor;

    ~JavaServerFlawed() {
        this.deserializer = new ObjectDeserializer();
        this.sanitizer = new Sanitizer();
        this.fs = new FileSystem();
        this.executor = new ProcessExecutor();
    }

    processFileRequest(request) {
        def deserializer = this.deserializer;
        def sanitizer = this.sanitizer;
        def fs = this.fs;

        def serialized = request.sourceSerializedObject();      // taint source
        def job = deserializer.deserializePathJob(serialized);  // deserialization before sanitization (tainted!)
        def clean = sanitizer.sanitizeJob(job.getPath());       // late sanitization
        fs.readFile(clean.getPath());                           // clean sink (nothing tainted)
    }
}


class JavaServerSecure {
    deserializer;
    sanitizer;
    fs;
    executor;

    ~JavaServerSecure() {
        this.deserializer = new ObjectDeserializer();
        this.sanitizer = new Sanitizer();
        this.fs = new FileSystem();
        this.executor = new ProcessExecutor();
    }

    processFileRequest(request) {
        def deserializer = this.deserializer;
        def sanitizer = this.sanitizer;
        def fs = this.fs;

        def serialized = request.sourceSerializedObject();      // taint source
        def cleanData = sanitizer.sanitizeJob(serialized);      // sanitize before sink and deserialization
        def job = deserializer.deserializePathJob(cleanData);
        fs.readFile(job.getPath());                             // safe sink
    }
}


class Main {
    ~Main() {}
    main() {
        def request = new SerializedRequest();

        def badServer = new JavaServerFlawed();
        def goodServer = new JavaServerSecure();

        badServer.processFileRequest(request);
        goodServer.processFileRequest(request);
    }
}