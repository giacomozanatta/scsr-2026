class TrafficMonitor {

    averageSpeed(totalDistance, timeSeconds) {
        def speed = totalDistance / timeSeconds;
        return speed;
    }

    flowRate(vehicles, laneCount) {
        def i = laneCount;
        while (i > 0) {
            i = i - 1;
        }
        def rate = vehicles / i;
        return rate;
    }

    occupancyRatio(occupied, total) {
        def ratio = 0;
        if (total > 0) {
            ratio = occupied / total;
        }
        return ratio;
    }
}
