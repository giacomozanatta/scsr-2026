class divByZeroConditional {

	// Test 1: Conditional division by zero
	conditionalDivision(flag) {
		def numerator = 100;
		def denominator = 10;
		if (flag)
			denominator = 0;
		def result = numerator / denominator;
		return result;
	}

	// Test 2: Division with zero in branch
	branchDivision(x) {
		def value = 50;
		if (x > 0)
			value = value / 0;
		else
			value = value / 2;
		return value;
	}

	// Test 3: Nested conditional division
	nestedConditional(a, b) {
		def num = 100;
		def den = 5;
		if (a > 0) {
			if (b < 0)
				den = 0;
		}
		def result = num / den;
		return result;
	}
}
