class strings {

    // --- sink functions ---

    fetch(url) {
    }

    processFile(filename) {
    }

    redirect(target) {
    }

    logAccess(target) {
    }

    // CASE 1: http:// URL passed directly to fetch
    // Expected: HTTPStringChecker warns (prefix is "http://")
    insecureUrl() {
        def url = "http://example.com/api/data";
        this.fetch(url);
    }

    // CASE 2: https:// URL — HTTPStringChecker also matches
    // because "https://" starts with "http"
    // Expected: HTTPStringChecker warns
    secureUrl() {
        def url = "https://example.com/api/data";
        this.fetch(url);
    }

    // CASE 3: .com suffix passed to processFile
    // Expected: DotComStringChecker warns
    dotComFile() {
        def filename = "setup.com";
        this.processFile(filename);
    }

    // CASE 4: safe .pdf file — no suffix match
    // Expected: NO warning (true negative)
    safeFile() {
        def filename = "report.pdf";
        this.processFile(filename);
    }

    // CASE 5: join of two http:// branches
    // Both branches produce an "http://" prefix — Prefix domain retains it
    // Expected: HTTPStringChecker warns on redirect call
    joinedHttpUrls(flag) {
        def target = "http://primary.com/home";
        if (flag) {
            target = "http://fallback.com/home";
        }
        this.redirect(target);
    }

    // CASE 6: join of two branches (one with http)
    // Both branches produce an "http://" prefix — Prefix domain retains it
    // Expected: HTTPStringChecker warns on redirect call
    joinedOneHttpUrl(flag) {
        def target = "http://primary.com/home";
        if (flag) {
            target = "foo";
        }
        this.redirect(target);
    }

    // CASE 7: .com domain passed directly as string
    // Expected: DotComStringChecker warns
    dotComDomain() {
        def domain = "backup.com";
        this.logAccess(domain);
    }

    // Real-world scenario: Server-Side Request Forgery (SSRF) via form input.
    // A backend service accepts a user-provided "resource path" from a form
    // and naively concatenates it with an internal base to build a fetch URL.
    // An attacker submits "http://169.254.169.254/latest/meta-data/" as the
    // resource path (AWS metadata endpoint). The concatenation produces a URL
    // with prefix "http://", which the server then fetches internally —
    // exposing cloud credentials, instance roles and private network topology.
    //
    // The HTTPStringChecker fires because the attacker-controlled input
    // carries prefix "http://" and flows directly into fetchResource(),
    // regardless of what the backend prepends to it.
    //
    // Expected: HTTPStringChecker warns on fetchResource call
    ssrfViaFormInput() {
        // attacker submits this as the "resource path" field in the form
        // the backend receives it as a raw string — modelled as a known
        // attacker-controlled constant for the purpose of this analysis
        def data_be  = "ht tp: // 169.254.169.254/latest/meta-data/";

        if (this.simulateHttpPresenceChecker()) {
            def sanitize_data_be = this.remove_blanks(data_be);
            this.redirect(sanitize_data_be);
        }


    }

    remove_blanks(data_be){
        return "http://169.254.169.254/latest/meta-data/";
    }

    simulateHttpPresenceChecker() {
        return 1;
    }


}
