class base {

	fConstants() {
		def neg_ExpectedNeg = -5;
		def zero_ExpectedZero = 0;
		def pos_ExpectedPos = 5;

		return;
	}

	fAddition() {
		def neg = -5;
		def zero = 0;
		def pos = 5;

		def add_Neg_Neg_ExpectedNeg = neg + neg;
		def add_Pos_Pos_ExpectedPos = pos + pos;
		def add_Neg_Zero_ExpectedNeg = neg + zero;
		def add_Pos_Zero_ExpectedPos = pos + zero;
		def add_Zero_Zero_ExpectedZero = zero + zero;
		def add_Neg_Pos_ExpectedTop = neg + pos;

		return;
	}

	fSubtraction() {
		def neg = -5;
		def zero = 0;
		def pos = 5;

		def sub_Neg_Pos_ExpectedNeg = neg - pos;
		def sub_Pos_Neg_ExpectedPos = pos - neg;
		def sub_Pos_Zero_ExpectedPos = pos - zero;
		def sub_Neg_Zero_ExpectedNeg = neg - zero;
		def sub_Zero_Pos_ExpectedNeg = zero - pos;
		def sub_Zero_Neg_ExpectedPos = zero - neg;
		def sub_Pos_Pos_ExpectedTop = pos - pos;
		def sub_Neg_Neg_ExpectedTop = neg - neg;

		return;
	}

	fMultiplication() {
		def neg = -5;
		def zero = 0;
		def pos = 5;

		def mul_Neg_Neg_ExpectedPos = neg * neg;
		def mul_Pos_Pos_ExpectedPos = pos * pos;
		def mul_Neg_Pos_ExpectedNeg = neg * pos;
		def mul_Pos_Neg_ExpectedNeg = pos * neg;
		def mul_Zero_Neg_ExpectedZero = zero * neg;
		def mul_Zero_Pos_ExpectedZero = zero * pos;
		def mul_Zero_Zero_ExpectedZero = zero * zero;

		return;
	}

	fDivision() {
		def neg = -5;
		def zero = 0;
		def pos = 5;

