class ExtendedSignTest {

    // CHECK 1 - Negative array index

    negativeIndexDefinite() {
        def arr = new int[5];
        def i = -3;          // LT0
        def x = arr[i];      // WARN: index is always negative
    }

    negativeIndexPossible(flag) {
        def arr = new int[5];
        def i = 2;           // GT0
        if (flag)
            i = -1;          // LT0 in true branch
                             // join: GT0 lub LT0 = NEQ0
        def x = arr[i];      // WARN: index sign is !=0
    }

    safeIndex() {
        def arr = new int[5];
        def i = 2;           // GT0
        def x = arr[i];      // SAFE
    }

    // CHECK 2 - Sign-flip in multiplication

    mulDefiniteNegative() {
        def speed = 10;      // GT0
        def dir = -1;        // LT0
        def v = speed * dir; // WARN: result is always negative
    }

    mulPossibleNegative(flag) {
        def a = 5;           // GT0
        def b = 3;           // GT0
        if (flag)
            b = -3;          // LT0 in true branch
                             // join: GT0 lub LT0 = NEQ0
        def c = a * b;       // WARN: result may be negative
    }

    mulSafe() {
        def a = 4;           // GT0
        def b = 2;           // GT0
        def c = a * b;       // SAFE
    }

    // CHECK 3 - Negative argument passed to a method call

    applySpeed(n) {
        def z = n * 1;
    }

    callWithNegativeDefinite() {
        def speed = -5;         // LT0
        this.applySpeed(speed); // WARN
    }

    callWithNegativePossible(flag) {
        def n = -1;          // LT0
        if (flag)
            n = 1;           // GT0 in true branch
                             // join: LT0 lub GT0 = NEQ0
        this.applySpeed(n);  // WARN
    }

    callSafe() {
        def speed = 10;         // GT0
        this.applySpeed(speed); // SAFE
    }
}