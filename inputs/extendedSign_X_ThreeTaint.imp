class taint_x_extendedSign {

	source1(){
		return -99;
	}

	sanitizer1(v){
		return 0;
	}


	sink1(v){
	}


	basic1() {
		def c = 5;

		this.sink1(c);
	}

	basic2() {
		def t = this.source1();

		this.sink1(t);
	}

	basic3() {
		def t = this.source1();

		def s = this.sanitizer1(t);

		this.sink1(s);
	}

	branch(b) {
		def m = 0;

		if(b) {
			m = this.source1();
		} else {
		  m = 5;
		}

		this.sink1(m);
	}

	loop(b)
	{
		def m = 0;
		def t = this.source1();

		while(t>0)
		{
			if(m%2 == 0)
			{
				m = 6;
			}

			else
				m = t;
		}

		this.sink1(m);
	}
}