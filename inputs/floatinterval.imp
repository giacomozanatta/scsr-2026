class floatinterval {

    // ====================================================================================
    // 1. COSTANTI INTERE E REALI
    // ====================================================================================
    constants() {
        def a = 3;       // [3, 3]
        def b = -2;      // [-2, -2]
        def z = 0;       // [0, 0]
        def f = 1.5;     // [1.5, 1.5], whereas in Interval [-inf, +inf]
        def g = -0.5;    // [-0.5, -0.5], whereas in Interval [-inf, +inf]
    }

    // ====================================================================================
    // 2. ADDIZIONE E SOTTRAZIONE
    //
    // [a,b] + [c,d] = [a+c, b+d]
    // [a,b] - [c,d] = [a-d, b-c]
    // ====================================================================================
    addition_subtraction() {
        def a = 1.5;     // [1.5, 1.5]
        def b = 0.5;     // [0.5, 0.5]

        def s = a + b;   // [2, 2]
        def d = a - b;   // [1.0, 1.0]
        def n = b - a;   // [-1.0, -1.0]
    }

    // ====================================================================================
    // 3. MOLTIPLICAZIONE
    //
    // [-2, 3] * [1, 4] = [min(-8,-2,3,12), max(-8,-2,3,12)] = [-8, 12]
    // ====================================================================================
    multiplication() {
        def a = 2;       // [2, 2]
        def b = 3;       // [3, 3]
        def r = a * b;   // [6, 6]

        def f = 1.5;     // [1.5, 1.5]
        def g = 2;       // [2, 2]  (si potrebbe scrivere 2 anche)
        def p = f * g;   // [3, 3]
    }

    multiplication_with_interval(flag) {
        def x = 0;
        if (flag > 0) {
          x = 3;
        } else {
          x = -2;
        }
        // After join: x ∈ [-2, 3]

        def y = 0;
        if (flag > 0) {
          y = 4;
        } else {
          y = -1;
        }
        // After join: y ∈ [-1, 4]

        def r = x * y;
        // 4 corners: (-2)*(-1)=2, (-2)*4=-8, 3*(-1)=-3, 3*4=12
        // result = [min(2,-8,-3,12), max(2,-8,-3,12)] = [-8, 12]
    }

    // ====================================================================================
    // 4. DIVISIONE REALE
    //    il risultato è più preciso della divisione intera, quindi è vantaggioso
    //
    // Esempio:
    // Divisione intera:  7 / 2 = 3       → [3, 3]
    // Divisione reale:   7 / 2 = 3.5     → [3.5, 3.5]
    // ====================================================================================
    division_real_vs_integer() {
        def n = 7;       // [7, 7]
        def d = 2;       // [2, 2]
        def q = n / d;   // [3.5, 3.5]  (intero darebbe [3, 3])

        def x = 1;       // [1, 1]
        def y = 3;       // [3, 3]
        def z = x / y;   // [0.3333, 0.3333]  (nulla vieterebbe di non troncare alla quarta cifra decimale)
    }

    // ====================================================================================
    // 5. DIVISIONE PER ZERO
    //
    // Divisore = [0, 0]:         BOTTOM (errore)
    // Divisore include 0:        TOP (possibile, ma non certa, divisione per zero)
    // ====================================================================================
    division_by_zero() {
        def n = 5;       // [5, 5]
        def z = 0;       // [0, 0]
        def r = n / z;   // BOTTOM (divisione per zero certa)
    }

    // ====================================================================================
    // 6. NEGAZIONE
    //
    // -[a, b] = [-b, -a]
    // ====================================================================================
    negation() {
        def a = 3;       // [3, 3]
        def b = 1.5;     // [1.5, 1.5]
        def na = -a;     // [-3, -3]
        def nb = -b;     // [-1.5, -1.5]
    }

    // ====================================================================================
    // 7. RAMI
    //    Viene richiamato lub dopo l'if-else, per effettuare la join dei due risultati
    //
    // [1.0, 1.0] U [2.5, 2.5] = [1.0, 2.5]
    // ====================================================================================
    branches(cond) {
        def x = 0;           // [0, 0]
        if (cond > 0) {
            x = 1;           // [1, 1]
        } else {
            x = 3;           // [3, 3]
        }
        // join: [1, 1] U [3, 3] = [1, 3]
        def after = x;       // [1, 3]

        def y = 0;
        if (cond > 0) {
            y = 1;           // [1, 1]
        } else {
            y = -1;          // [-1, -1]
        }
        // join: [1, 1] U [-1, -1] = [-1, 1]
        def after2 = y;      // [-1, 1]
    }

    // ====================================================================================
    // 8. LOOP
    //    NB: Se non ci fosse il widening, l'analisi andrebbe in loop infinito
    // ====================================================================================
    loop_int_step() {
        def x = 0;           // [0, 0]
        while (x < 10)
            x = x + 1;       // [0, 1] --> [0, 2] --> ... loop, viene bloccato grazie al widening
        return x;            // [0, +inf]
    }

    loop_frac_step() {
        def s = 1;             // [1, 1]
        def acc = 0;           // [0, 0]
        while (s > 0) {
            s = s / 2;         // [0.5, 0.5] --> [0.25,0.25] --> ... loop, viene bloccato grazie al widening
            acc = acc + s;
        }
        return acc;
    }

    // ====================================================================================
    // 9. SERIE DI OPERAZIONI
    //
    // a = 1.0, b = 2, c = 3
    // s = a + b + c = 6.0    --> [6.0, 6.0]
    // m = s / 3 = 2          --> [2, 2]
    // n = a / 3 = 0.3333     --> [0.3333, 0.3333]
    // n2 = 5 / 2 + 5 / 2     --> [2.5, 2.5]
    //
    // NB: s / 3 = 6 / 3 = 2 --> coincide anche nel caso degli interi, ma
    //     n = a / 3 = 1 / 3 = 0.3333 --> nel caso degli interi, avrei perso precisione
    //     e analogamente con n2, dove negli interi avrei avuto
    //
    // ====================================================================================
    chain_of_ops() {
        def a = 1;           // [1, 1]
        def b = 2;           // [2, 2]
        def c = 3;           // [3, 3]
        def s = a + b + c;   // [6, 6]
        def n = 3;           // [3, 3]
        def avg = s / n;     // [2, 2]
        return avg;
    }
}
