class Main {
    main() {
        def a = 1.5;
        def b = 2.5;
        
        // Test Addizione: [1.5, 1.5] + [2.5, 2.5] 
        def c = a + b; // Atteso: [4.0, 4.0]
        
        // Test Sottrazione: [4.0, 4.0] - [2.5, 2.5]
        def d = c - b; // Atteso: [1.5, 1.5]
        
        // Test Negazione Unaria: -[1.5, 1.5]
        def e = -d;    // Atteso: [-1.5, -1.5]
        
        // Test Moltiplicazione: [-1.5, -1.5] * [2.0, 2.0]
        def f = e * 2.0; // Atteso: [-3.0, -3.0]
        
        // Test Divisione: [-3.0, -3.0] / [2.0, 2.0]
        def g = f / 2.0; // Atteso: [-1.5, -1.5]
    }
}

class Main2 {
    main() {
        // Test addizione
        def a = 2.0;
        def b = 3.0;
        def add = a + b;       // Atteso: [5.0, 5.0]

        // Test sottrazione
        def sub = a - b;       // Atteso: [-1.0, -1.0]

        // Test moltiplicazione positivi
        def mul = a * b;       // Atteso: [6.0, 6.0]

        // Test moltiplicazione con negativo
        def neg = -2.0;
        def mulneg = neg * b;  // Atteso: [-6.0, -6.0]

        // Test divisione
        def div = b / a;       // Atteso: [1.5, 1.5]

        // Test divisione per negativo
        def divneg = neg / a;  // Atteso: [-1.0, -1.0]

        // Test con zero
        def z = 0.0;
        def addzero = a + z;   // Atteso: [2.0, 2.0]
        def mulzero = a * z;   // Atteso: [0.0, 0.0]
    }
}

class Main3 {
    main() {
        // Test addizione
        def a = 1.7;
        def b = 2.3;
        def add = a + b;       // Atteso: [4.0, 4.0]

        // Test sottrazione
        def sub = a - b;       // Atteso: [-0.6, -0.6]

        // Test moltiplicazione positivi
        def mul = a * b;       // Atteso: [3.91, 3.91]

        // Test moltiplicazione con negativo
        def neg = -1.3;
        def mulneg = neg * b;  // Atteso: [-2.99, -2.99]

        // Test divisione
        def div = a / b;       // Atteso: [0.739..., 0.739...]

        // Test divisione per negativo
        def divneg = neg / a;  // Atteso: [-0.764..., -0.764...]

        // Test somma con tre decimali
        def c = 1.25;
        def d = 2.75;
        def add2 = c + d;      // Atteso: [4.0, 4.0]

        // Test moltiplicazione con tre decimali
        def mul2 = c * d;      // Atteso: [3.4375, 3.4375]
    }
}