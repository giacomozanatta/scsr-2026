class DefiniteTaintTest {

    
    @lisa.taint.Source
    readSecretFile() {
        return "password123";
    }

    
    @lisa.taint.Sink
    sendToExternalServer(data) {
        return 0;
    }

    testDefinite() {
        
        def x = this.readSecretFile();

       
        this.sendToExternalServer(x);

        return 1;
    }
}