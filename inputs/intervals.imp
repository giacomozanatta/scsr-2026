class intervals {

    constants() {
        def a = 3;       // [3, 3]
        def b = -2;      // [-2, -2]
        def z = 0;       // [0, 0]
        def f = 1.5;     // [1.5, 1.5] // [-inf, +inf]
        def g = -0.5;    // [-0.5, -0.5] // [-inf, +inf]
    }

	basic() {
		def i = 2;
		def j = -10;
		def a = i + j;
		def s = i - j;
//		def m = i * j;
//		def d = i / j;
//      def l = -i;
	}

	branches(b) {
		def x = 0;
		if (b)
           	x = x + 7;
       	else
           	x = -7;
		return x;
  }

	loop(b) {
			def c = 1;
			
			while (b < 3) {
				c = c + 1;
				b = b + 1; 
			}
			return c; 
	}
}
