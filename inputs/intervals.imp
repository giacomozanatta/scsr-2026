class intervals {

	basic() {
		def i = 2.5;
		def j = -10.5;
		def a = i + j;
		def s = i - j;
		def m = i * j;
		def d = i / j;
		def banana = 2/d;
        def l = -i;
	}

	int_and_float(){
	    def i = 2;
	    def f = 3.0;

	    def sum = i + f;
	}

	branches(b) {
		def x = 0;
		if (b)
           	x = x + 0.1;
       	else
           	x = -0.3;
		return x;
  }

	loop(b) {
			def c = 1;
			
			while (b < 10) {
				c = c + 1;
				b = b + 1; 
			}
			return c; 
	}

	looping_indefinite(b){
	    def res = 0.5;
	    while(b){
	        res = res + 0.5;
	        b = 0;
	    }
        b = 1;
	    while(b){
	        res = res - 0.5;
	        b = 0;
	    }

        // res is between 0 and 0.5. Lower bound if init b is false (or 0, if C style), higher bound if b is true
	    return res;
	}

	slides(z) {
	    def x = 11;
	    x = x + 10;
	    def y = 2;
	    y = y + 8;

	    x = x / y;
	    return;

	}

	possible_div_by_zero(a){
	    def x = 1;
	    if(a > 0)
    	    x = x + 2;
    	else
    	    x = x + 0;
	    def y = -1;
	    if(a > 0)
	        y = y + 2;
        else
            y = y + 0;
	    def div = x/y;
	    return div;

	}

	floaties(){
	    def x = 1.0;
	    def y = 2.5;

	    def add = x + y;
	    return add;
	}


}
