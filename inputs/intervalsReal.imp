class intervals {
	basic() {
		def i = 2.23;
		def j = -10.9;
		def a = i + j;
		def s = i - j;
		def m = i * j;
		def d = i / j;
		def l = -i;
	}

	branches(b) {
		def x = 0;
		if (b)
           	x = x + 7.9;
       	else
           	x = -7;
		return x;
  }

	loop(b) {
		def c = 1;
		while (b < 3) {
			c = c + 1;
			b = b + 1;
		}
		return c;
	}

	loopReal() {
		def x = 0.0;
		def step = 0.5;
		def i = 0;
		while (i < 10) {
			x = x + step;
			i = i + 1;
		}
		return x;
	}
}
