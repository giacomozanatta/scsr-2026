/*
    Test Program: SensorProcessor, aka embedded ADC pipeline for a multichannel data acquisition board.

    Target Checkers:
        DivByZeroIntervalChecker and DivByZeroPentagonChecker
            - "definitely" fires when denominator interval = [0, 0]
              (NOTE: LiSA 0.2 NPEs on literal /0; use parameter-based TOP to trigger "may be")
            - "may be" fires when denominator interval includes 0

        OverflowIntervalChecker(min, max)
            - fires on arithmetic operations when result interval is NOT in [min, max]
            - 8-bit : [-128, 127]
            - 16-bit : [-32768, 32767]
            - 32-bit : [-2147483648, 2147483647]

    Author: Gianmaria Pizzo 872966
 */
class SensorProcessor {

    // 1. Division-by-zero cases

    /*
        Fixed-divisor calibration

        Expected: No Warning (gainFactor = [128, 128]) as does not include 0
     */
    factoryCalibrate() {
        def rawReading = 1024;
        def gainFactor = rawReading/8;

        return gainFactor;
    }

    /*
        Possible div-by-zero

        sampleCount is a parameter -> interval = TOP = [-inf, +inf], includes 0.

        Expected: Warning (both checkers) as sampleCount may be 0
     */
    computeAverage(total, sampleCount) {
        def avg = total/sampleCount;

        return avg;
    }

    /*
        Guarded div-by-zero

        Expected: No Warning
     */
    safeAverage(total, sampleCount) {
        def avg = 0;

        if (sampleCount > 0)
            avg = total/sampleCount;

        return avg;
    }

    computeRelativeGain(a, b) {
        // a and b are TOP

        def gain = 0;

        if (a < b) {
            // diff is TOP (includes 0) as we cannot prove (b-a) > 0
            def diff = b - a; // should create MAY warn of this

            // proves diff >=1
            gain = 100 / diff; // no warn
        }

        return gain;
    }


    // 2. 8-bit overflow [-128, 127]

    /*
        Sum of two high samples

        Expected: Warning (8-bit) but not for 16-bit and 32-bit
     */
    addTwoHighSamples() {
        def a = 100;
        def b = 100;

        // 100 + 100 = 200 > 127
        def sum = a+b;

        return sum;
    }

    /*
        Subtract large offset

        Expected: Warning (8-bit underflow) but not for 16-bit and 32-bit
     */
    subtractLargeOffset() {
        def baseline = -100;
        def offset = -100;

        // -100 + (-100) = -200 < -128
        def adjusted = baseline + offset;

        return adjusted;
    }

    /*
        Apply gain factor

        Expected: Warning (8-bit) but not for 16-bit and 32-bit
     */
    applyGain8bit() {
        def raw = 10;
        def gain = 20;

        // 10 * 20 = 200 > 127
        def amplified = raw * gain;

        return amplified;
    }


    // 3. 16-bit overflow [-32768, 32767]

    /*
        Sum of two high-frequency readings

        Expected: Warning (16-bit) but not for 32-bit
     */
    sumHighFrequencyReadings() {
        def ch1 = 30000;
        def ch2 = 30000;

        // 30000 + 30000 = 60000 > 32767
        def sum = ch1 + ch2;

        return sum;
    }

    /*
        Compute negative delta

        Expected: Warning (16-bit underflow) but not for 32-bit
     */
    computeNegativeDelta() {
        def base = -20000;
        def delta = 20000;

        // -20000 - 20000 = -40000 < -32768
        def result = base - delta;

        return result;
    }

    /*
        Square amplitude

        Expected: Warning (8-bit and 16-bit) but not for 32-bit
     */
    squareAmplitude() {
        def amplitude = 200;

        // 200 * 200 = 40000 > 32767
        // Also 200 > 127 (Warning 8 bit on constant)
        def squared = amplitude * amplitude;

        return squared;
    }


    // 4. 32-bit overflow [-2147483648, 2147483647]

    /*
        Accumulate a large buffer

        Expected: Warning (8-bit, 16-bit, and 32-bit)
     */
    accumulateLargeBuffer() {
        def blockA = 2000000000;
        def blockB = 2000000000;

        // 2000000000 + 2000000000 = 4000000000 > Integer.MAX_VALUE.
        def total  = blockA + blockB;

        return total;
    }


    // 5. Loop overflow (all bit widths)

    /*
        Accumulate samples in a loop

        Expected: Warning (8-bit, 16-bit, and 32-bit) on both acc and i after widening
     */
    accumulateSamples(n) {
        def acc = 0;
        def i = 0;

        while (i < n) {
            acc = acc + 1;
            i = i + 1;
        }

        return acc;
    }


    // 6. Combined scenarios

    /*
        Compute normalized power

     */
    computeNormalizedPower() {
        def voltage = 200;
        def current = 200;
        def channels = 4;

        // 200 * 200 = 40000 -> Warning (8/16-bit overflow)
        def power = voltage * current;

        // 
        def perChannel = power / channels;

        return perChannel;
    }

    /*
        Process raw reading from unknown parameter

     */
    processRawReading(reading) {
        // reading is TOP = [-inf, +inf]

        // reading + reading = TOP -> Warning (all overflow)
        def doubled = reading + reading;

        // normalized = 1024 / reading -> Warning (both checkers, reading includes 0)
        def normalized = 1024 / reading;

        return normalized;
    }

    /*
        Sliding-window average over 8 unknown samples
     */
    slidingWindowAverage(s0, s1, s2, s3, s4, s5, s6, s7) {
        // Each sample is TOP and each addition can overflow

        def sum = s0 + s1;
        sum = sum + s2;
        sum = sum + s3;
        sum = sum + s4;
        sum = sum + s5;
        sum = sum + s6;
        sum = sum + s7;

        // No div by 0
        def avg = sum / 8;

        // Result stays TOP
        return avg;
    }

}
