// ================================================================
//  DIV BY ZERO TEST SUITE
//  Target checkers:
//    - DivByZeroIntervalChecker  (uses IntInterval / Interval domain)
//    - DivByZeroPentagonChecker  (uses PentagonLattice domain)
//
//  Each class documents:
//    [INTERVAL]  expected result from DivByZeroIntervalChecker
//    [PENTAGON]  expected result from DivByZeroPentagonChecker
//
//  Warning levels used by both checkers:
//    DEFINITE  -> denominator abstract value == [0,0]
//    POSSIBLE  -> denominator abstract value includes 0  (e.g. [-1,1])
//    NONE      -> denominator abstract value excludes 0  (e.g. [1, MAX])
// ================================================================


// ----------------------------------------------------------------
//  TEST 1 - Definite division by zero (literal zero denominator)
//
//  Real-world inspiration: NASA Mars Climate Orbiter (1999).
//  A unit-conversion bug caused a navigation value to become 0,
//  which was then used as a divisor in a trajectory update,
//  crashing the spacecraft into Mars.
//
//  Here a "unit scale factor" is set to 0 because the engineer
//  forgot to convert metric to imperial before use.
//
//  [INTERVAL]  POSSIBLE warning on  result = distance / scale
//               (parameters are TOP without ContextBasedAnalysis;
//                scale includes 0 -> POSSIBLE, not DEFINITE)
//  [PENTAGON]  POSSIBLE warning on  result = distance / scale
// ----------------------------------------------------------------
class MarsOrbiterNavigation {

    convertTrajectory(distance, scale) {
        def result = distance / scale;
        return result;
    }

    main() {
        def distance = 890000;
        def scale = 0;
        def trajectory = this.convertTrajectory(distance, scale);
        return trajectory;
    }
}


// ----------------------------------------------------------------
//  TEST 2 - Possible division by zero via loop counter
//
//  Real-world inspiration: integer countdown reaching zero used
//  as divisor (pattern found in embedded retry-loop firmware).
//  A retry counter decrements from N to 0; the remaining budget
//  is used to compute the share of work per remaining attempt.
//  When the last retry fires the counter is already 0.
//
//  The abstract interval of `retries` after the loop is [0, 5]
//  (widening loses the "strictly positive" information), so:
//
//  [INTERVAL]  POSSIBLE warning on  share = remaining / retries
//  [PENTAGON]  POSSIBLE warning on  share = remaining / retries
// ----------------------------------------------------------------
class RetryScheduler {

    computeShare(total_work, max_retries) {
        def retries = max_retries;
        def done = 0;

        while (retries > 0) {
            done = done + 1;
            retries = retries - 1;
        }

        // After loop: retries == 0 at runtime, but both domains
        // abstract retries to [0, max_retries] -> includes 0
        def share = total_work / retries;
        return share;
    }

    main() {
        def result = this.computeShare(100, 5);
        return result;
    }
}


// ----------------------------------------------------------------
//  TEST 3 - Division guarded by IF: no warning expected
//
//  Real-world inspiration: correct defensive programming pattern
//  used in financial settlement systems (e.g., FIX protocol
//  engines) that guard every divisor before use.
//
//  The guard `if (participants > 0)` guarantees the denominator
//  is at least 1 inside the true branch.
//
//  [INTERVAL]  NO warning  (interval of participants inside branch = [1, MAX])
//  [PENTAGON]  NO warning  (Pentagon refines to participants >= 1)
// ----------------------------------------------------------------
class SettlementEngine {

    splitAmount(total, participants) {
        def share = 0;
        if (participants > 0) {
            share = total / participants;
        }
        return share;
    }

    main() {
        def total = 50000;
        def participants = 4;
        def result = this.splitAmount(total, participants);
        return result;
    }
}


// ----------------------------------------------------------------
//  TEST 4 - Pentagon precision advantage over Interval
//           (relational constraint on the divisor itself)
//
//  Real-world inspiration: request dispatcher that divides work
//  among active workers. The number of workers `workers` is
//  guarded directly by `if (workers > 0)` before use as divisor.
//
//  Interval domain: the parameter `workers` has interval
//  [-INF, +INF] at method entry (unknown caller), so after the
//  guard the interval is still [1, +INF] — actually Interval CAN
//  refine this via assume, so both domains give NO warning here.
//
//  The key difference: if the guard were `if (end > start)` on a
//  DERIVED variable `d = end - start`, Interval would lose the
//  link between `d` and the guard variable and report POSSIBLE,
//  while Pentagon tracks `workers > 0` directly on the divisor
//  variable, proving safety without needing relational reasoning
//  over derived values.
//
//  Here both domains produce NO warning because the guard is on
//  the divisor directly — this is the SAFE baseline for TEST 4.
//  Compare with TEST 2 where no guard exists.
//
//  [INTERVAL]  NO warning  (assume on workers refines to [1, +INF])
//  [PENTAGON]  NO warning  (Pentagon tracks workers > 0 directly)
// ----------------------------------------------------------------
class RequestDispatcher {

    computeShare(total_requests, workers) {
        def share = 0;
        if (workers > 0) {
            share = total_requests / workers;
        }
        return share;
    }

    main() {
        def requests = 320;
        def w = 4;
        def result = this.computeShare(requests, w);
        return result;
    }
}


// ----------------------------------------------------------------
//  TEST 5 - Interprocedural definite division by zero
//
//  Real-world inspiration: average computation delegated to a
//  utility function, caller passes a literal 0 as count —
//  forgetting to handle the empty-list case.
//  (classic bug in analytics / reporting pipelines).
//
//  Without ContextBasedAnalysis the literal `count = 0` is NOT
//  propagated into `computeAverage`: parameters are abstracted to
//  TOP at method entry, so `count` has interval [-INF,+INF] which
//  includes 0 -> POSSIBLE (not DEFINITE).
//  With ContextBasedAnalysis the literal would be propagated and
//  the warning would be DEFINITE.
//
//  [INTERVAL]  POSSIBLE warning on  avg = total / count
//  [PENTAGON]  POSSIBLE warning on  avg = total / count
// ----------------------------------------------------------------
class AnalyticsPipeline {

    computeAverage(total, count) {
        def avg = total / count;
        return avg;
    }

    processEvents(event_sum, event_count) {
        def result = this.computeAverage(event_sum, event_count);
        return result;
    }

    main() {
        def sum = 0;
        def count = 0;
        def avg = this.processEvents(sum, count);
        return avg;
    }
}


// ----------------------------------------------------------------
//  TEST 6 - Definite division by zero via uninitialised capacity
//
//  Real-world inspiration: hash-table bucket index computed as
//  `key / table_size` to select a partition shard. If the table
//  is initialised with size 0 (lazy initialisation never triggered
//  before the first query), the division raises ArithmeticException.
//  This pattern is found in sharded cache implementations where
//  capacity is set lazily at first write, not at construction.
//  [INTERVAL]  POSSIBLE warning on  shard = key / table_size
//               (parameters are TOP without ContextBasedAnalysis;
//                table_size includes 0 -> POSSIBLE, not DEFINITE)
//  [PENTAGON]  POSSIBLE warning on  shard = key / table_size
// ----------------------------------------------------------------
class HashTable {

    getShard(key, table_size) {
        def shard = key / table_size;
        return shard;
    }

    main() {
        def key = 42;
        def table_size = 0;
        def s = this.getShard(key, table_size);
        return s;
    }
}
