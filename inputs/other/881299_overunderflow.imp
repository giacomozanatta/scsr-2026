// Description: Simulates a bank account system where large deposits,
// withdrawals and interest multiplications on values close to INT_MAX
// can cause integer overflow and underflow.

class bank {

    deposit(balance, amount) {
        return balance + amount;
    }

    withdraw(balance, amount) {
        return balance - amount;
    }

    apply_interest(balance, rate) {
        return balance * rate;
    }

    main() {
        def balance         = 2000000000;
        def deposit_amount  = 200000000;
        def withdraw_amount = -2000000000;
        def rate            = 3;

        def balance2 = this.deposit(balance, deposit_amount);
        def balance3 = this.withdraw(balance2, withdraw_amount);
        def balance4 = this.apply_interest(balance3, rate);

        return balance4;
    }
}