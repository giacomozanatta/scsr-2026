class PaginationSystem {

    computeTotalPages() {
        def totalItems = 250;
        def itemsPerPage = 20;
        def userOverride = 0;

        if (userOverride == 0) {
            itemsPerPage = 0;
        } else {
            itemsPerPage = userOverride;
        }

        def totalPages = totalItems / itemsPerPage;

        return totalPages;
    }
}

// ----------------------------------------
// From 895227_897270 — div_by_zero_interval_3
// ----------------------------------------
class ThermalSensor {

    processTemperature() {
        def tempReading = 10;
        def i = 0;

        while (i < 20) {
            tempReading = tempReading - 1;
            i = i + 1;
        }

        def calibration = 0;

        if (tempReading != 0) {
            calibration = 500 / tempReading;
        } else {
            calibration = -1;
        }

        return calibration;
    }
}

// ----------------------------------------
// From 895227_897270 — div_by_zero_interval_1
// ----------------------------------------
class ECommerce {

    applyDynamicDiscount() {
        def cartTotal = 1000;
        def daysToExpiration = 5;
        def finalPrice = 0;

        while (daysToExpiration > -5) {
            def priceRatio = cartTotal / daysToExpiration;
            finalPrice = finalPrice + priceRatio;
            daysToExpiration = daysToExpiration - 1;
        }

        return finalPrice;
    }
}

// ----------------------------------------
