class dbz {

    f1() {
        def time = 3;

        if (time > 0) {
            time = 0;
        } else {
            time = 9;
        }

        def space = 7;
        def speed = space/time;

        if(time != 0) {
            def acceleration = 5;
            def new_speed = 0.5*acceleration*(time*time);
        }

        return;
    }
}

