class pressure {

    calculate_volume(l,w,h) {
        return l * w * h;
    }

    calculate_pressure(h) {
        return (1 * 8.314462 * 100) / this.calculate_volume(10,10,h);
    }
}

// ----------------------------------------
// From 913849 — div_by_zero2
// ----------------------------------------
class prices {
    price;
    old_price;
    old_price_ratio;

    ~prices(){
        this.price = 10000;
    }

    update() {
        return this.old_price / this.price;
    }

    reduce_price(reduction){
        this.old_price = this.price;
        this.price = this.price - reduction;
        this.update();
    }
}
