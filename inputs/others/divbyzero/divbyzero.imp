class divbyzero {

    literalZero() {
        def x = 10;
        def result = x / 0;
        return result;
    }

    safeConstantDivisor() {
        def total = 256;
        def size = 16;
        def idx1 = total / size;
        def idx2 = 128 / size;
        def idx3 = 64 / size;
        return idx1;
    }

    safeProductDivisor() {
        def a = 3;
        def b = 5;
        def divisor = a * b;
        def result = 900 / divisor;
        return result;
    }
}

