// ----------------------------------------
// From 895227_897270 — overflow_interval_2
// ----------------------------------------
class SmartContract {

    mintTokens() {
        def totalSupply = 1000000;
        def userBalance = 0;
        def isMinting = 1;

        while (isMinting > 0) {
            userBalance = userBalance + 500;
            totalSupply = totalSupply + 500;
        }

        return userBalance;
    }
}

// ----------------------------------------
// From 895227_897270 — overflow_interval_3
// ----------------------------------------
class SubmarineNavigation {

    calculateDepth() {
        def currentAltitude = 0;
        def diveRate = 15;
        def sensorActive = 1;

        while (sensorActive == 1) {
            currentAltitude = currentAltitude - diveRate;
        }

        return currentAltitude;
    }
}

// ----------------------------------------
// From 881299 — overunderflow
// ----------------------------------------
class bank {

    deposit(balance, amount) {
        return balance + amount;
    }

    withdraw(balance, amount) {
        return balance - amount;
    }

    apply_interest(balance, rate) {
        return balance * rate;
    }

    main() {
        def balance         = 2000000000;
        def deposit_amount  = 200000000;
        def withdraw_amount = -2000000000;
        def rate            = 3;

        def balance2 = this.deposit(balance, deposit_amount);
        def balance3 = this.withdraw(balance2, withdraw_amount);
        def balance4 = this.apply_interest(balance3, rate);

        return balance4;
    }
}
