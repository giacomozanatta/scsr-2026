class ofuf {

    f0() {
        def player_lvl = 127;
        def exp = 7;

        def progress = player_lvl + exp;

        if(progress > 127)
            player_lvl = 0;

        def penalty_for_cheating = player_lvl - exp;

        return;
    }

    f1() {
        def price_per_item = 127;
        def num_items = 7;

        def total_revenue = price_per_item * num_items;
        def warehouse_cost = price_per_item * price_per_item * 3;

        def revenue_per_item = price_per_item / num_items;

        def debt = -127;
        def debt_after_penalty = debt - 2;

        return;
    }
}

// ----------------------------------------
// From 904329 — overflowunderflow_2
// ----------------------------------------
class ofuf {

    f2() {
        def player_one_hp = 125;
        def cumulative_damage = 127;
        def player_two_hp = 1;
        def num_of_players = 3;

        while(num_of_players > 2) {
            player_one_hp = player_one_hp - 1;
            cumulative_damage = cumulative_damage + 1;
            player_two_hp = player_two_hp - 1;
            num_of_players = num_of_players - 1;
        }

        return;
    }
}

