class WebScraper {

    fetch(url) {
        return url;
    }

    testHttpsUrl() {
        def url = "https://api.example.com/v1/data";
        def result = this.fetch(url);
        return result;
    }

    testHttpUrl() {
        def url2 = "http://legacy.example.com/endpoint";
        def result = this.fetch(url2);
        return result;
    }

    testSafeRelativePath() {
        def path = "/api/v1/data";
        def result = this.fetch(path);
        return result;
    }
}

