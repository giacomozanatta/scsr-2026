    runQueryDB(query) {
    }

    // ----------------------------------------
    // From 876957 — 876957-taint
    // ----------------------------------------
    testDirectInjection() {
        def userInput = this.GetRequest();
        def query = userInput;
        this.runQueryDB(query);
    }

    // ----------------------------------------
    // From 876957 — 876957-taint
    // ----------------------------------------
    testMixedQuery(isAdmin) {
        def userInput = this.GetRequest();
        def query = 0;
        if (isAdmin) {
            query = this.sanitizeInput(userInput);
        } else {
            query = userInput;
        }
        this.runQueryDB(query);
    }
}

