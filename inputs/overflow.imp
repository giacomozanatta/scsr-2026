class overflow {

    // WARN (8-bit overflow): 100 * 100 = 10000 > 127
    testOverflow8bit() {
        def x = 100;
        def y = x * x;
        return y;
    }

    // WARN (16-bit overflow): 200 * 200 = 40000 > 32767
    testOverflow16bit() {
        def x = 200;
        def y = x * x;
        return y;
    }

    // WARN (32-bit overflow): x doubles each iteration,
    // widening pushes interval to [1, +inf) which exceeds INT_MAX
    testOverflow32bit() {
        def x = 1;
        def i = 0;
        while (i < 40) {
            x = x * 2;
            i = i + 1;
        }
        return x;
    }

    // WARN (underflow): -200 * -200... wait, let's do subtraction
    // -100 - 100 = -200 < -128 for int8
    testUnderflow8bit() {
        def x = -100;
        def y = x - 100;
        return y;
    }

    // WARN (definite division by zero): denominator is exactly 0

    testDefiniteDivZero() {
            def x = 10;
            def y = 5;
            def d = y - 5;   // d = [0,0], computed — not a literal
            return x / d;    // WARN: d = [0,0] → definite division by zero
    }

    // WARN (possible division by zero): i crosses zero inside loop
    // widening gives i = [-3, +inf) at loop head
    // assume i < 3 gives i = [-3, 2] which includes 0
    testPossibleDivZero() {
        def x = 100;
        def i = -3;
        while (i < 3) {
            x = x / i;   // WARN: i ∈ [-3, 2], includes 0
            i = i + 1;
        }
        return x;
    }

    // NO WARN: denominator is provably positive
    testSafeDivision() {
        def x = 100;
        def d = 5;
        return x / d;   // safe: d = [5,5], 0 not included
    }
}