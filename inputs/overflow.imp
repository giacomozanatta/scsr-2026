class overflow {

    // 8-bit overflow: 100 * 100 = 10000, exceeds Byte.MAX_VALUE (127)
    testOverflow8bit() {
        def x = 100;
        def y = x * x;    // WARN (8-bit): 10000 > 127
        return y;
    }

    // 16-bit overflow: 200 * 200 = 40000, exceeds Short.MAX_VALUE (32767)
    testOverflow16bit() {
        def x = 200;
        def y = x * x;    // WARN (16-bit): 40000 > 32767
        return y;
    }

    // 32-bit overflow: x doubles each iteration, widening sends it to [1,+inf)
    // Use a bounded counter so the loop has a concrete exit condition
    testOverflow32bit() {
        def x = 1;
        def i = 0;
        while (i < 40) {
            x = x * 2;    // WARN (32-bit): interval widens to [1,+inf) > INT_MAX
            i = i + 1;
        }
        return x;
    }



    // Possible division by zero: loop counter starts at 0,
    // so after widening i is in [0,+inf) which includes 0
    testPossibleDivZero() {
        def x = 100;
        def i = 0;
        def n = 10;
        while (i < n) {
            i = i + 1;
        }
        return x / i;     // WARN: "This may be a possible division by zero"
    }
}