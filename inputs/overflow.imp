class processor {

	sumScores() {
		def total = 0;
		def i = 0;
		while (i < 100) {
			total = total + 50;
			i = i + 1;
		}
		return total;
	}
}

class geometry {

	area(width, height) {
		def a = width * height;
		return a;
	}
}

class smallCalc {

	sumHours() {
		def fixed = 5;
		def base = fixed + fixed;
		def total = base * 3;
		return total;
	}
}
