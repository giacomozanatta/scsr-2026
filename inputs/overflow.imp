 *   This file was developed with the support of Claude (Anthropic, claude-sonnet-4-6).
 *   The following prompt was used to guide the generation:
 *
 *   "I need a meaningful IMP test program for a static analysis course project.
 *    The program should be inspired by a real-world domain where integer overflow,
 *    underflow, and division-by-zero bugs are well-documented. It should test
 *    8-bit, 16-bit, and 32-bit overflow/underflow, definite and possible division
 *    by zero, and include safe baseline cases for comparison.
 *    Each method should have a clear real-world motivation and inline comments explaining the
 *    expected checker behavior."
 *
 *   The output was reviewed, tested, and validated against LiSA's checkers by the author.
 */
/*
 * Test Program: ImageProcessor
 *
 * Real-world motivation:
 *   Image processing pipelines operate on pixel values (0–255 for 8-bit),
 *   intermediate buffers (16-bit), and full-image accumulators (32-bit).
 *   Unchecked arithmetic on pixel data is a well-known source of overflow
 *   bugs — for example, OpenCV historically had integer overflow issues in
 *   histogram equalization and contrast adjustment filters.
 *
 *   This program models a simplified image processing pipeline and tests:
 *     - 8-bit overflow/underflow  (pixel channel values)
 *     - 16-bit overflow/underflow (intermediate convolution buffers)
 *     - 32-bit overflow           (full-image histogram accumulation)
 *     - Division by zero          (region averaging with empty region)
 */
class ImageProcessor {

    // ----------------------------------------------------------------
    // 1. Pixel brightness adjustment (8-bit channel, range [-128, 127])
    // ----------------------------------------------------------------

    /*
     * Increase brightness by adding a large offset to a high pixel value.
     * Real bug: brightness += delta without clamping to [0, 255].
     *
     * Expected: OVERFLOW warning (8-bit) — 100 + 80 = 180 > 127
     *           No warning for 16-bit and 32-bit
     */
    increaseBrightness() {
        def pixel = 100;
        def delta = 80;
        def result = pixel + delta;
        return result;
    }

    /*
     * Decrease brightness by subtracting a large offset from a dark pixel.
     * Real bug: brightness -= delta without clamping.
     *
     * Expected: UNDERFLOW warning (8-bit) — -80 - 80 = -160 < -128
     *           No warning for 16-bit and 32-bit
     */
    decreaseBrightness() {
        def pixel = -80;
        def delta = 80;
        def result = pixel - delta;
        return result;
    }

    /*
     * Safe brightness adjustment within range.
     *
     * Expected: No warning at any bit width — 30 + 20 = 50
     */
    safeBrightnessAdjust() {
        def pixel = 30;
        def delta = 20;
        def result = pixel + delta;
        return result;
    }

    // ----------------------------------------------------------------
    // 2. Contrast stretching (16-bit intermediate buffer [-32768, 32767])
    // ----------------------------------------------------------------

    /*
     * Multiply two channel values to compute a contrast factor.
     * Real bug: 16-bit intermediate overflow in contrast enhancement filters.
     *
     * Expected: OVERFLOW warning (8-bit and 16-bit) — 200 * 200 = 40000 > 32767
     *           No warning for 32-bit
     */
    computeContrastFactor() {
        def a = 200;
        def b = 200;
        def factor = a * b;
        return factor;
    }

    /*
     * Compute negative delta between two channel buffers.
     * Real bug: 16-bit underflow in difference image computation.
     *
     * Expected: UNDERFLOW warning (16-bit) — -20000 - 20000 = -40000 < -32768
     *           No warning for 32-bit
     */
    computeChannelDifference() {
        def base = -20000;
        def ref  = 20000;
        def diff = base - ref;
        return diff;
    }

    // ----------------------------------------------------------------
    // 3. Histogram accumulation (32-bit accumulator)
    // ----------------------------------------------------------------

    /*
     * Accumulate pixel intensities across a very large image buffer.
     * Real bug: 32-bit accumulator overflow on high-resolution images.
     *
     * Expected: OVERFLOW warning (all bit widths) — 2e9 + 2e9 > INT_MAX
     */
    accumulateHistogram() {
        def blockA = 2000000000;
        def blockB = 2000000000;
        def total  = blockA + blockB;
        return total;
    }

    /*
     * Accumulate pixel values in a loop (simulates iterating over image rows).
     * After widening: acc = [0, +inf) which exceeds INT_MAX.
     *
     * Expected: OVERFLOW warning (all bit widths) after widening
     */
    accumulateRows(n) {
        def acc = 0;
        def i   = 0;
        while (i < n) {
            acc = acc + 255;
            i   = i + 1;
        }
        return acc;
    }

    // ----------------------------------------------------------------
    // 4. Region averaging — division by zero
    // ----------------------------------------------------------------

    /*
     * Compute the average pixel value in a selected region.
     * regionSize is a parameter -> interval = TOP = [-inf, +inf], includes 0.
     *
     * Expected: WARNING (both div-zero checkers) — regionSize may be 0
     */
    computeRegionAverage(totalIntensity, regionSize) {
        def avg = totalIntensity / regionSize;
        return avg;
    }

    /*
     * Guarded region average — check before dividing.
     *
     * Expected: No warning — regionSize > 0 is enforced by the branch
     */
    safeRegionAverage(totalIntensity, regionSize) {
        def avg = 0;
        if (regionSize > 0) {
            avg = totalIntensity / regionSize;
        }
        return avg;
    }

    /*
     * Sliding-window average over a strip of pixels.
     * The denominator is a literal constant (8), so always > 0.
     * The numerator accumulates unknown pixel values (TOP).
     *
     * Expected: OVERFLOW warnings (all bit widths) on accumulation steps,
     *           No div-zero warning (denominator = 8, provably non-zero)
     */
    slidingWindowAverage(p0, p1, p2, p3, p4, p5, p6, p7) {
        def sum = p0 + p1;
        sum = sum + p2;
        sum = sum + p3;
        sum = sum + p4;
        sum = sum + p5;
        sum = sum + p6;
        sum = sum + p7;
        def avg = sum / 8;
        return avg;
    }

    /*
     * Definite division by zero: denominator computed as 5 - 5 = [0, 0].
     * Note: a literal /0 causes a LiSA framework NPE (known bug), so we
     * use a computed zero instead.
     *
     * Expected: DEFINITE div-zero warning
     */
    divideByComputedZero() {
        def x = 255;
        def y = 5;
        def d = y - 5;
        return x / d;
    }

    /*
     * Possible division by zero: loop counter crosses zero.
     * After widening at the loop head: i in [-4, +inf),
     * assume(i < 4) refines to [-4, 3] which includes 0.
     *
     * Expected: POSSIBLE div-zero warning inside loop
     */
    scanlineNormalize() {
        def x = 1000;
        def i = -4;
        while (i < 4) {
            x = x / i;
            i = i + 1;
        }
        return x;
    }
}