class overflow{
    // integer
    //*******************************************
    integer_1(){
        def integer = 0;
        integer = integer + 2147483647 + 1;
        integer = 0;
        integer = integer - 2147483647 - 2;
        return integer;
    }
    integer_definite_looping_overflow(){
        def integer = 0;
        for(def i = 0; i < 2147483647 + 2 ; i = i + 1){
            integer = integer + 1;
        }
        return integer;
    }
    integer_loop_branching_overflow(){
        def max = 10;
        def integer = 2147483647 - 2;
        def flag = 1;
        for(def i = 0; i < max; i = i+1){
            if(flag == 1){
                integer = integer + 1;
            }
            else{
                integer = integer + 0;
            }
        }
    }

    integer_loop_branching_no_overflow(){
        def max = 10;
        def integer = 2147483647 - 2;
        def flag = 0;
        for(def i = 0; i < max; i = i+1){
            if(flag == 1){
                integer = integer + 1;
            }
            else{
                integer = integer + 0;
            }
        }
    }

    integer_array_access(){
        def integer = 2147483647;
        def arr = new int[1];
        arr[0] = 1;
        integer = integer + arr[0]*2;
    }

    get_one(){
        return 1;
    }
    get_zero(){
        return 0;
    }
    integer_function_call(){
        def integer = 2147483647;
        integer = integer + this.get_one();
        integer = 0;
        integer = integer + this.get_zero();
    }
}