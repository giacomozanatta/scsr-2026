// ================================================================
//  OVERFLOW / UNDERFLOW TEST SUITE
//  Target checker: OverflowIntervalChecker (Integer Interval domain)
//
//  The checker is parameterised at construction time by a
//  representable range [l, u]. We test the same programs against
//  three instantiations:
//    8-bit  signed : [-128, 127]
//    16-bit signed : [-32768, 32767]
//    32-bit signed : [-2147483648, 2147483647]
//
//  The checker triggers on Addition / Subtraction / Multiplication /
//  Division / IMPAddOrConcat. For each such statement, the abstract
//  value of the RESULT is compared with the representable range:
//      result.high > u   ->  "overflow"
//      result.low  < l   ->  "underflow"
//      both              ->  "over/underflow"
//      neither           ->  no warning
//
//  Warning notation per statement:
//      [8] / [16] / [32]   each is one of OVER, UNDER, OVER/UNDER, NONE
//
//  Scope of each class:
//    SensorBuffer       -> width-sensitive constants (same expression,
//                          different result depending on N-bit width)
//    PriceLedger        -> sign-sensitive arithmetic (additions and
//                          subtractions, signed overflow vs underflow)
//    MatrixMultiplier   -> multiplication/division blow-up and loops
//                          (widening of interval ranges inside loops)
// ================================================================


// ----------------------------------------------------------------
//  CLASS 1 - SensorBuffer
//
//  Scope: tests where the SAME arithmetic expression produces
//          DIFFERENT warnings depending on integer width. The
//          constants are picked so that the result lies inside
//          32-bit range, possibly inside 16-bit range, and outside
//          8-bit range — letting us verify the checker reacts to
//          its parametrisation.
//
//  Real-world inspiration: embedded firmware reading temperature
//  and pressure values from analog sensors and accumulating them
//  into running totals. On 8-bit MCUs (Arduino-style) these
//  accumulators overflow constantly; on 16- or 32-bit MCUs they
//  do not.
// ----------------------------------------------------------------
class SensorBuffer {

    // -------- Test 1.1 : result fits in 16-bit and 32-bit, NOT in 8-bit --------
    // raw = 200 + 100 = 300. Range:
    //   8-bit  [-128,127] : result 300 > 127  -> OVERFLOW
    //   16-bit [-32768,32767]                 -> NONE
    //   32-bit                                -> NONE
    //
    // [8]  OVER on  raw = high + low
    // [16] NONE
    // [32] NONE
    readTemperature() {
        def high = 200;
        def low  = 100;
        def raw  = high + low;
        return raw;
    }

    // -------- Test 1.2 : result fits in 32-bit only --------
    // raw = 30000 + 5000 = 35000.
    //   8-bit  : OVERFLOW
    //   16-bit : 35000 > 32767                -> OVERFLOW
    //   32-bit : NONE
    //
    // [8]  OVER
    // [16] OVER
    // [32] NONE
    readPressure() {
        def baseline = 30000;
        def delta    = 5000;
        def raw      = baseline + delta;
        return raw;
    }

    // -------- Test 1.3 : result overflows ALL three widths --------
    // huge = 2000000000 + 2000000000 = 4000000000.
    //   8-bit  : OVERFLOW
    //   16-bit : OVERFLOW
    //   32-bit : 4000000000 > 2147483647      -> OVERFLOW
    //
    // [8]  OVER
    // [16] OVER
    // [32] OVER
    readGigaCounter() {
        def half_a = 2000000000;
        def half_b = 2000000000;
        def huge   = half_a + half_b;
        return huge;
    }

    // -------- Test 1.4 : underflow via subtraction (width-sensitive) --------
    // diff = -100 - 50 = -150.
    //   8-bit  : -150 < -128                  -> UNDERFLOW
    //   16-bit : NONE
    //   32-bit : NONE
    //
    // [8]  UNDER
    // [16] NONE
    // [32] NONE
    biasOffset() {
        def offset = -100;
        def trim   = 50;
        def diff   = offset - trim;
        return diff;
    }

    // -------- Test 1.5 : every operation stays in range for all widths --------
    // a = 10 + 5 = 15, b = a - 3 = 12. All in [-128,127].
    // Sanity baseline: no instantiation should warn.
    //
    // [8]  NONE on every op
    // [16] NONE
    // [32] NONE
    calibrate() {
        def a = 10 + 5;
        def b = a - 3;
        return b;
    }

    // -------- Test 1.6 : interval split between fit and overflow --------
    // The variable `level` has interval [50, 200] after the join.
    // delta = level + 100 has interval [150, 300].
    //   8-bit  : high 300 > 127               -> OVERFLOW
    //   16-bit : NONE
    //   32-bit : NONE
    // Note: this checks that the checker looks at the RESULT's
    // upper bound, not just on concrete values.
    //
    // [8]  OVER
    // [16] NONE
    // [32] NONE
    classifyReading(mode) {
        def level = 0;
        if (mode > 0) {
            level = 200;
        }
        else {
            level = 50;
        }
        def delta = level + 100;
        return delta;
    }

    main() {
        def r1 = this.readTemperature();
        def r2 = this.readPressure();
        def r3 = this.readGigaCounter();
        def r4 = this.biasOffset();
        def r5 = this.calibrate();
        def r6 = this.classifyReading(1);
        return r6;
    }
}


// ----------------------------------------------------------------
//  CLASS 2 - PriceLedger
//
//  Scope: tests covering BOTH signed bounds simultaneously.
//          - additions that push past the upper bound
//          - subtractions that push past the lower bound
//          - one expression producing an interval that straddles
//            BOTH bounds (over/underflow combined)
//          - chained operations where the intermediate result
//            already overflows
//
//  Real-world inspiration: financial ledger storing balances in
//  fixed-width integers (e.g. cents). Such ledgers historically
//  exhibit both overflow (large credits) and underflow (large
//  debits or short-sells) when widths are too narrow.
// ----------------------------------------------------------------
class FinancialLedger {

    // -------- Test 2.1 : both bounds breached at once --------
    // The result interval contains both bounds.
    //
    // amount is set to either 200 or -200 via branches, so its
    // interval after the join is [-200, 200].
    //   8-bit  : -200 < -128  AND  200 > 127  -> OVER/UNDER
    //   16-bit : NONE
    //   32-bit : NONE
    //
    // The expression that triggers is the unary join itself only
    // if the checker visits assignments, but here we force an
    // arithmetic op by adding 0: amount + 0 still has interval
    // [-200, 200] and IS visited (Addition node).
    //
    // [8]  OVER/UNDER on  signed_amount = amount + 0
    // [16] NONE
    // [32] NONE
    swingTrade(direction) {
        def amount = 0;
        if (direction > 0) {
            amount = 200;
        }
        else {
            amount = -200;
        }
        def signed_amount = amount + 0;
        return signed_amount;
    }

    // -------- Test 2.3 : chained arithmetic, FIRST op overflows --------
    // step1 = 100 + 100 = 200 -> overflows 8-bit
    // step2 = step1 - 50 = 150 -> still overflows 8-bit
    // Two separate warnings expected on the 8-bit run, both NONE
    // for 16-bit and 32-bit.
    //
    // [8]  OVER on  step1 = a + b
    //      OVER on  step2 = step1 - c
    // [16] NONE on both
    // [32] NONE on both
    accumulate() {
        def a = 100;
        def b = 100;
        def c = 50;
        def step1 = a + b;
        def step2 = step1 - c;
        return step2;
    }

    // -------- Test 2.4 : chained arithmetic, RECOVERY in second op --------
    // step1 = 100 + 50 = 150 -> overflows 8-bit
    // step2 = step1 - 50 = 100 -> in range
    // We want to see that the second op no longer warns on 8-bit.
    //
    // [8]  OVER on  step1
    //      NONE on  step2
    // [16] NONE on both
    // [32] NONE on both
    overshootAndRecover() {
        def step1 = 100 + 50;
        def step2 = step1 - 50;
        return step2;
    }

    // -------- Test 2.5 : 16-bit edge underflow --------
    // diff = -30000 - 5000 = -35000.
    //   8-bit  : UNDERFLOW
    //   16-bit : -35000 < -32768              -> UNDERFLOW
    //   32-bit : NONE
    //
    // [8]  UNDER
    // [16] UNDER
    // [32] NONE
    shortSell() {
        def position = -30000;
        def loss     = 5000;
        def diff     = position - loss;
        return diff;
    }

    // -------- Test 2.6 : 32-bit edge underflow --------
    // diff = -2000000000 - 200000000 = -2200000000.
    //   8-bit  : UNDERFLOW
    //   16-bit : UNDERFLOW
    //   32-bit : -2200000000 < -2147483648    -> UNDERFLOW
    //
    // [8]  UNDER
    // [16] UNDER
    // [32] UNDER
    massiveDrawdown() {
        def position = -2000000000;
        def loss     = 200000000;
        def diff     = position - loss;
        return diff;
    }

    // -------- Test 2.7 : safe ledger entry, no warnings on any width --------
    // [8]  NONE
    // [16] NONE
    // [32] NONE
    safeEntry() {
        def credit = 20;
        def debit  = 5;
        def net    = credit - debit;
        return net;
    }

    main() {
        def r1 = this.swingTrade(1);
        def r2 = this.overdraft();
        def r3 = this.accumulate();
        def r4 = this.overshootAndRecover();
        def r5 = this.shortSell();
        def r6 = this.massiveDrawdown();
        def r7 = this.safeEntry();
        return r7;
    }
}


// ----------------------------------------------------------------
//  CLASS 3 - MatrixMultiplier
//
//  Scope: tests covering multiplication blow-up, division, and
//          loops where widening expands the result interval.
//          - multiplication that overflows on small widths
//          - multiplication where ONE operand has a wide interval
//            (TOP-like) and the result is unbounded
//          - division reducing the magnitude (safe on all widths)
//          - loop accumulator widened beyond representable range
//          - loop counter products
//
//  Real-world inspiration: numerical kernels (matrix multiply,
//  convolution, dot product). These are notorious overflow sites
//  on narrow-integer hardware: products of two non-trivial values
//  exceed the operand width by design.
// ----------------------------------------------------------------
class Calculator {

    // -------- Test 3.1 : product overflows 8-bit but fits 16-bit --------
    // p = 20 * 20 = 400.
    //   8-bit  : 400 > 127                    -> OVERFLOW
    //   16-bit : NONE
    //   32-bit : NONE
    //
    // [8]  OVER on  p = a * b
    // [16] NONE
    // [32] NONE
    productSmall() {
        def a = 20;
        def b = 20;
        def p = a * b;
        return p;
    }

    // -------- Test 3.2 : product overflows 8-bit AND 16-bit --------
    // p = 1000 * 100 = 100000.
    //   8-bit  : OVERFLOW
    //   16-bit : 100000 > 32767               -> OVERFLOW
    //   32-bit : NONE
    //
    // [8]  OVER
    // [16] OVER
    // [32] NONE
    productMid() {
        def a = 1000;
        def b = 100;
        def p = a * b;
        return p;
    }

    // -------- Test 3.3 : product overflows 32-bit --------
    // p = 100000 * 100000 = 10^10.
    //   8-bit / 16-bit : OVERFLOW
    //   32-bit         : 10^10 > 2147483647   -> OVERFLOW
    //
    // [8]  OVER
    // [16] OVER
    // [32] OVER
    productHuge() {
        def a = 100000;
        def b = 100000;
        def p = a * b;
        return p;
    }

    // -------- Test 3.4 : negative * positive -> underflow --------
    // p = -100 * 50 = -5000.
    //   8-bit  : -5000 < -128                 -> UNDERFLOW
    //   16-bit : NONE
    //   32-bit : NONE
    //
    // [8]  UNDER
    // [16] NONE
    // [32] NONE
    signedProductMid() {
        def neg = -1000;
        def pos = 100;
        def p   = neg * pos;
        return p;
    }

    signedProductSmall() {
        def neg = -100;
        def pos = 50;
        def p   = neg * pos;
        return p;
    }

    signedProductBig() {
        def neg = -100000;
        def pos = 100000;
        def p   = neg * pos;
        return p;
    }

    // -------- Test 3.5 : interval blow-up across multiplication --------
    // After the if/else, `x` has interval [-100, 100]. p = x * x.
    // Abstract multiplication on intervals yields [-10000, 10000].
    //   8-bit  : high 10000 > 127 AND low -10000 < -128 -> OVER/UNDER
    //   16-bit : NONE
    //   32-bit : NONE
    //
    // [8]  OVER/UNDER on  p = x * x
    // [16] NONE
    // [32] NONE
    squareInterval(mode) {
        def x = 0;
        if (mode > 0) {
            x = 100;
        }
        else {
            x = -100;
        }
        def p = x * x;
        return p;
    }

    // -------- Test 3.6 : division shrinks magnitude, always safe --------
    // q = 100 / 4 = 25. Trivially in range for all widths.
    //
    // [8]  NONE on  q = num / den
    // [16] NONE
    // [32] NONE
    average() {
        def num = 100;
        def den = 4;
        def q   = num / den;
        return q;
    }

    // -------- Test 3.7 : loop accumulator widened past 8-bit, fits 16-bit --------
    // Inside the loop, `acc = acc + 10` is repeatedly executed.
    // After widening, acc's upper bound goes to +INF, so the result
    // interval of `acc + 10` has high = +INF, which exceeds every
    // representable range -- all three widths warn OVERFLOW.
    //
    // [8]  OVER on  acc = acc + 10  (inside loop)
    // [16] OVER
    // [32] OVER
    accumulate(n) {
        def acc = 0;
        def i = 0;
        while (i < n) {
            acc = acc + 10;
            i = i + 1;
        }
        return acc;
    }

    // -------- Test 3.8 : loop counter increment, bounded by condition --------
    // The loop condition `i < 100` is used by the interval domain to
    // refine `i` in the body to [0, 99]. The increment `i = i + 1`
    // produces a value in [1, 100], well within all widths.
    //
    // [8]  NONE on  i = i + 1
    // [16] NONE
    // [32] NONE
    countToHundred() {
        def i = 0;
        def total = 0;
        while (i < 100) {
            total = total + 1;
            i = i + 1;
        }
        return total;
    }

    // -------- Test 3.9 : nested arithmetic where intermediate overflows --------
    // inner = 100 + 100 = 200          (8-bit OVER)
    // outer = inner * 2 = 400          (8-bit OVER, others NONE)
    // final = outer - 50 = 350         (8-bit OVER, others NONE)
    // Three warnings on 8-bit, none on the others.
    //
    // [8]  OVER on  inner = a + b
    //      OVER on  outer = inner * 2
    //      OVER on  final = outer - 50
    // [16] NONE on all three
    // [32] NONE on all three
    nestedChain() {
        def a = 100;
        def b = 100;
        def inner = a + b;
        def outer = inner * 2;
        def final_val = outer - 50;
        return final_val;
    }

    main() {
        def r1 = this.dotProductSmall();
        def r2 = this.dotProductMid();
        def r3 = this.dotProductHuge();
        def r4 = this.signedProduct();
        def r5 = this.squareInterval(1);
        def r6 = this.averagePixel();
        def r7 = this.accumulate(50);
        def r8 = this.countToHundred();
        def r9 = this.nestedChain();
        return r9;
    }
}
