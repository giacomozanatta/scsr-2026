class prefixConditional {

	// Test 1: Conditional http prefix
	conditionalHttp(useHttps) {
		def url;
		if (useHttps)
			url = "https://secure.example.com";
		else
			url = "http://example.com";
		connect(url);
		return url;
	}

	// Test 2: Http prefix in branch
	branchHttp(flag) {
		def url = "ftp://example.com";
		if (flag)
			url = "http://example.com";
		connect(url);
		return url;
	}

	// Test 3: Nested conditional http
	nestedConditional(isSecure, isPublic) {
		def url;
		if (isSecure) {
			if (isPublic)
				url = "https://public.example.com";
			else
				url = "https://private.example.com";
		} else {
			url = "http://example.com";
		}
		connect(url);
		return url;
	}
}
