class arraybounds{
    basic_assignment(any_index){
        def arr0 = new int[10];
        def arr1 = new int[100];

        arr0[0] = 0;
        arr1[0] = 1;

        arr0 = new int[1];
        arr1 = new int[10];

        def neg = -1;
        arr0[neg] = 9999; // Definitely Out of bounds
        arr1[any_index] = 9999; // Possibly Out of bounds
    }

    index_from_heap(){
        def arr = new int[1];
        arr[0] = 5;
        def i = arr[0];
        return arr[i];
    }

    index_from_heap_multicell(){
        def arr = new int[4];
        arr[0] = 0;
        arr[1] = 10;
        arr[2] = 10;
        arr[3] = 10;
        def i = arr[0];
        return arr[i]; // Field sensitive heap --> `arr[0]` has its own interval, unaffected by the other memory locations of this array
                       // Field insensitive heap --> `arr[0]` shares the same abstraction with other array locations
    }

    branch_def_exceed(b){
        def a = new int[3];
        def foo = 0;
        if(b == 0){
            foo = a[0];
        }
        else{
            foo = a[3];
        }

        return foo;
    }

    array_var_bound(n){
        def a = new int[n];
        def banana = 0;
        for(def i = 0; i < n; i = i + 1){
            banana = banana + a[i];
        }
        return banana;
    }

}