class cartesian{

    sink(i)
    {

    }

    source()
    {
        return -1;
    }

    sanitize(i)
    {
        if(i < 0)
            return -i;
        return i;
    }

    cart1()
    {
        def x = 1;
        this.sink(x);

        def y = -5;
        this.sink(y);

        def z = 0;
        this.sink(y);
    }

    cart2()
    {
        def x = this.source();
        x = -x;
        x = this.sanitize(x);
        this.sink(x);
    }

    cart3()
    {
        def x = this.source();
        if(x % 2 == 0)
        {
            x = this.sanitize(x);
        }
        this.sink(x);
    }

    cart4()
    {
        def x = this.source();
        def y = this.source();
        x = this.sanitize(x) + this.sanitize(y);
        
        this.sink(x);
    }

    cart5()
    {
        def x = -4;
        x = x + this.source();
        x = this.sanitize(x);
        this.sink(x);
    }

    cart6()
    {
        def x = -4;
        x = this.source();
        def i = x;
        if(i % 2 == 0)
        {
            x = this.sanitize(x);
        }
        this.sink(x);
    }

    nested_sanitizer(x)
    {
        x = this.sanitize(x);
        return x;
    }

    cart7()
    {
        def x = this.source();
        x = -x;
        x = this.nested_sanitizer(x);
        this.sink(x);
    }

    cart8()
    {
        def x = this.source();
        if(x % 2 == 0)
        {
            x = this.nested_sanitizer(x);
        }
        this.sink(x);
    }

    cart10()
    {
        def x = -4;
        x = this.source();
        x = this.nested_sanitizer(x);
        this.sink(x);
    }

    cart11()
    {
        def x = -4;
        x = this.source();
        if(x % 2 == 0)
        {
            x = this.nested_sanitizer(x);
        }
        this.sink(x);
    }

    cart12(p)
    {
        def x = p;
        this.sink(x);
    }

    cart13(p)
    {
        def x = this.sanitize(p);
        this.sink(x);
    }

    cart14(p)
    {
        def x = this.nested_sanitizer(p);
        this.sink(x);
    }
}
