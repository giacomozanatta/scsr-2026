class signs {

    // costanti: verifica che i letterali vengano astratti nel segno corretto
    constants() {
        def zero  = 0;    // ZERO
        def pos   = 5;    // POS
        def neg   = -3;   // NEG
    }

    // negazione unaria: inverte il segno
    // -POS = NEG, -NEG = POS, -ZERO = ZERO
    negation() {
        def a = 4;        // POS
        def b = -7;       // NEG
        def z = 0;        // ZERO
        def na = -a;      // -POS = NEG
        def nb = -b;      // -NEG = POS
        def nz = -z;      // -ZERO = ZERO
    }

    // addizione: POS+NEG=TOP (non deterministico), stessi segni si conservano
    // POS + POS = POS, NEG + NEG = NEG
    // ZERO + POS = POS, ZERO + NEG = NEG, ZERO + ZERO = ZERO
    // POS + NEG = TOP, NEG + POS = TOP
    addition() {
        def p = 3;           // POS
        def n = -2;          // NEG
        def z = 0;           // ZERO

        def pp = p + p;      // POS + POS = POS
        def nn = n + n;      // NEG + NEG = NEG
        def zz = z + z;      // ZERO + ZERO = ZERO
        def pz = p + z;      // POS + ZERO = POS
        def zp = z + p;      // ZERO + POS = POS
        def nz = n + z;      // NEG + ZERO = NEG
        def zn = z + n;      // ZERO + NEG = NEG
        def pn = p + n;      // POS + NEG = TOP
        def np = n + p;      // NEG + POS = TOP
    }

    // sottrazione: a - b = a + (-b), si inverte il segno del sottraendo
    // POS - NEG = POS, NEG - POS = NEG
    // POS - ZERO = POS, ZERO - NEG = POS
    // NEG - ZERO = NEG, ZERO - POS = NEG
    // ZERO - ZERO = ZERO
    // POS - POS = TOP, NEG - NEG = TOP
    subtraction() {
        def p = 6;            // POS
        def n = -4;           // NEG
        def z = 0;            // ZERO

        def zz = z - z;       // ZERO - ZERO = ZERO
        def pz = p - z;       // POS  - ZERO = POS
        def zn = z - n;       // ZERO - NEG  = POS
        def pn = p - n;       // POS  - NEG  = POS

        def nz = n - z;       // NEG  - ZERO = NEG
        def zp = z - p;       // ZERO - POS  = NEG
        def np = n - p;       // NEG  - POS  = NEG

        def pp = p - p;       // POS  - POS  = TOP (es. 5-3=2 POS, ma 3-5=-2 NEG)
        def nn = n - n;       // NEG  - NEG  = TOP
    }

    // moltiplicazione: regola dei segni
    // POS * POS = POS, NEG * NEG = POS
    // POS * NEG = NEG, NEG * POS = NEG
    // ZERO * qualsiasi = ZERO (anche ZERO * TOP = ZERO)
    multiplication() {
        def p = 4;            // POS
        def n = -3;           // NEG
        def z = 0;            // ZERO

        def pp = p * p;       // POS * POS = POS
        def nn = n * n;       // NEG * NEG = POS
        def pn = p * n;       // POS * NEG = NEG
        def np = n * p;       // NEG * POS = NEG
        def zp = z * p;       // ZERO * POS = ZERO
        def zn = z * n;       // ZERO * NEG = ZERO
        def zz = z * z;       // ZERO * ZERO = ZERO
    }

    // divisione: divisione per zero -> BOTTOM (codice irraggiungibile)
    // ZERO / qualsiasi = ZERO, stessi segni -> POS, segni opposti -> NEG
    division() {
        def p = 9;            // POS
        def n = -6;           // NEG
        def z = 0;            // ZERO

        def pz = p / z;       // POS / ZERO = BOTTOM (divisione per zero)
        def nz = n / z;       // NEG / ZERO = BOTTOM (divisione per zero)
        def zp = z / p;       // ZERO / POS = ZERO
        def zn = z / n;       // ZERO / NEG = ZERO
        def pp = p / p;       // POS  / POS = POS
        def nn = n / n;       // NEG  / NEG = POS
        def pn = p / n;       // POS  / NEG = NEG
        def np = n / p;       // NEG  / POS = NEG

        // Casi che mostrano l'unsoundness di sign nel caso di divisione intera (a causa del troncamento a zero)
        def p1 = 1;
        def p2 = 3;
        def n1 = -1;
        def n2 = -3;

        def r_p1p2 = p1 / p2;  // 1/3   = 0  (ZERO) --> sign restituisce POS --> unsound
        def r_p2p1 = p2 / p1;  // 3/1   = 3  (POS)  --> sign restituisce POS --> corretto
        def r_n1p2 = n1 / p2;  // -1/3  = 0  (ZERO) --> sign restituisce NEG --> unsound
        def r_n2p1 = n2 / p1;  // -3/1  = -3 (NEG)  --> sign restituisce NEG --> corretto
        def r_n1n2 = n1 / n2;  // -1/-3 = 0  (ZERO) --> sign restituisce POS --> unsound
        def r_n2n1 = n2 / n1;  // -3/-1 = 3  (POS)  --> sign restituisce POS --> corretto
        def r_p1n2 = p1 / n2;  // 1/-3  = 0  (ZERO) --> sign restituisce NEG --> unsound
        def r_p2n1 = p2 / n1;  // 3/-1  = -3 (NEG)  --> sign restituisce NEG --> corretto
    }

    // -------------------------------------------------------------------------
    // Questo esempio è per dimostrare la minore precisione rispetto a extendedsign;
    // verrà emesso un warning dal checker per una divisione per zero, benché d sia != 0
    // -------------------------------------------------------------------------
    safe_division(b) {
        def d = 0;
        if (b > 0)
            d = 3;           // POS
        else
            d = -1;          // NEG
        // d = TOP --> divisione potenzialmente NON sicura, dato il rischio di una divisione per zero, benché d sia != 0
        def n = 10;
        def result = n / d;  // TOP, dato che d è TOP; warning emesso dal checker per potenziale divisione per zero, dato che TOP include 0
    }

    // rami: il join (lub) al merge point unisce i due segni
    // POS lub NEG = TOP, POS lub POS = POS, ecc.
    branches(p) {
        def x = 0;           // ZERO
        if (p > 0)
            x = 5;           // POS
        else
            x = -3;          // NEG
        def after_pn = x;    // POS lub NEG = TOP

        def y = 0;           // ZERO
        if (p > 0)
            y = 3;           // POS
        else
            y = 7;           // POS
        def after_pp = y;    // POS lub POS = POS
    }

    // loop con incremento positivo: il segno si perde dopo il join all'header
    // ZERO lub POS = TOP -> b diventa TOP dentro il loop
    loop_pos_step() {
        def b = 0;           // ZERO
        while (b < 20)
            b = b + 1;       // join(ZERO, POS) = TOP -> b = TOP + POS = TOP
        return b;
    }

    // loop con incremento negativo: stessa perdita di informazione
    loop_neg_step() {
        def b = 0;           // ZERO
        while (b > -20)
            b = b - 1;       // join(ZERO, NEG) = TOP
        return b;
    }

    // -------------------------------------------------------------------------
    // 12. DIVISORE IN DIVERSI RAMI
    //
    // Tre casi a confronto tra sign ed extended sign:
    //   a) POS/POS --> nessun warning
    //   b) POS/NEG --> sign: warning (falso positivo); in extended sign non viene emesso il warning, dato che si sa che il divisore è NON_ZERO
    //   c) NEG/NEG --> nessun warning
    // -------------------------------------------------------------------------
    realistic_index(flag) {

        def capacity = 100;      // POS

        // --- caso a) base sempre POS
        def base_a = 0;
        if (flag > 0)
            base_a = 6;          // POS
        else
            base_a = 2;          // POS
        // join: POS lub POS = POS
        def result_a = capacity / base_a;  // nessun warning

        // --- caso b) base POS o NEG: il divisore è sicuramente != 0, ma qui su sign viene base_b viene considerato TOP, quindi viene emesso un warning
        // extended sign è più preciso, dato che base_b viene considerato come NON_ZERO
        def base_b = 0;
        if (flag > 0)
            base_b = 6;          // POS
        else
            base_b = -2;         // NEG
        // join: POS lub NEG = TOP
        def result_b = capacity / base_b; // !!! WARNING !!! --> non succede su extended sign

        // --- caso c) base sempre NEG
        def base_c = 0;
        if (flag > 0)
            base_c = 10;         // NEG
        else
            base_c = 5;          // NEG
        // join: NEG lub NEG = NEG
        def result_c = capacity / base_c;  // nessun warning
    }
}
