class signs {
	loop() {
		def c = 1;
		def b = 0;
   		while (b < 10)
        	b = b + c;
   		return b;
    }

	basic() {
		def i = 2; // i = +
		def j = -10; // j = -
		def a = i + j; // a = + ADD - = TOP
		def s = i - j; // s = + SUB - = + --- TOP because it should be implemented before 
		def m = i * j;
		def d = i / j;
	}

	branches() {
	    def a = 3;
	    def b = 5;
		def x = 0;
		if (a > b)
           	x = x * 7;
       	else
           	x = -7;
		def y = x / x;
    }
	
	setSpeed(n){
		// do something about speed
	}
	
	moveForward1() {
		def n = 10;
		this.setSpeed(n); // ok, we are
	}
	
	moveForward2() {
		def n = -10;
		this.setSpeed(n); // we have a problem here!
	}
	
	moveForward3(b) {
		def n = -1;
		if (b)
           	n = 1;
		
		this.setSpeed(n); // we may have a problem here! n may be negative depending on b that is statically unknow
    }

	source1(){
		return -99;
	}

	sanitizer1(v){
		return 0;
	}


	sink1(v){
	}


	basic1() {
		def c = 0;

		this.sink1(c);  // the value is clean
	}

	basic2() {
		def t = this.source1();

		this.sink1(t); // a tainted value flows in a sink!
	}

	basic3() {
		def t = this.source1();

		def s = this.sanitizer1(t);

		this.sink1(s);  // the value is clean due to sanitization
	}

	branch(b) {
		def m = 0;

		if(b) {
			m = this.source1();
		} else {
		  m = 5;
		}

		this.sink1(m); // the value may be tainted
	}



}
