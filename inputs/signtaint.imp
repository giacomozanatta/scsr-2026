class taint {

	source1(){
		return 99;
	}

	possibleSource(){
		return 123;
	}

	mayTint(v){
		if (v > 50) {
			return -99;
		} else {
			return 0;
		}
	}

	sanitizer1(v){
		return 0;
	}

	sink1(v){
	}


	basic1() {
		def c = 0;

		this.sink1(c);  // the value is clean
		c = c + 5;
		c = -25;
		c = -8 * c;
	}

	basic2(h) {
		def t = 0;
		t = this.source1();

		this.sink1(t); // a tainted value flows in a sink!
		t = t + h;
		t = t - 87;
		h = this.sanitizer1(t);
		this.sink1(h);
	}

	branch(b) {
		def m = 0;

		if(b) {
			m = this.source1();
		} else {
			m = 5;
			if (b > 54) {
				m = -51;
			} else {
				m = 0;
			}
			def g = m;
			if (g) {
				g = 0;
			} else {
				g = 21;
			}
			this.sink1(g);
			m = 0;
		}

		this.sink1(m); // the value may be tainted
	}



}
