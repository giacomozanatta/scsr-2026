class hospitalRecords {

    // Tainted source with a positive constant.
    readInput() {
        return 1001;
    }

    // Tainted source with a negative constant.
    source1() {
        return -7;
    }

    cleanData(v) {
        return v;// normalizes/validates the patient ID
    }

    sanitizer1(v) {
        return v;// strips/escapes unsafe characters from the doctor's note
    }


    runQueryDB(v) {
    }

    printSensitive(v) {
    }

    sink1(v) {
    }

    // test 1: tainted value flows into a sink
    test1() {
        def patientId = this.readInput();
        this.runQueryDB(patientId);
    }


    // test 2: positive tainted value is sanitized
    test2() {
        def rawId = this.readInput();
        def validId = this.cleanData(rawId);
        if(validId>0)
            this.runQueryDB(validId);
    }


    // test 3: internal positive constant
    test3() {
        def internalId = 42;
        this.runQueryDB(internalId);
    }


    // test 4: two tainted values are combined
    test4() {
        def id = this.readInput();
        def noteRef = this.source1();
        def combined = id + noteRef;
        this.sink1(combined);
    }


    // test 5: conditional flow, should report POSSIBLE taint
    test5(cond) {
        def id = 42;

        if (cond) {
            id = this.readInput();
        }

        this.runQueryDB(id);
    }


    // test 6: tainted value multiplied by zero
    test6() {
        def id = this.readInput();
        def result = id * 0;
        this.runQueryDB(result);
    }


}