class strings {

    fetch(url) {
        def result = "fetching: " + url;
        return result;
    }
    resolve(domain) {
        def result = "resolving: " + domain;
        return result;
    }
    sendEmail(recipient, body) {
        def result = "sent to: " + recipient;
        return result;
    }
    log(msg) {
        def out = "log: " + msg;
        return out;
    }

    // WARN (HTTP prefix): literal https url passed to fetch
    testHttpsDirect() {
        def r = this.fetch("https://api.example.com/data");
        return r;
    }

    // WARN (HTTP prefix): literal http url (insecure)
    testHttpDirect() {
        def r = this.fetch("http://legacy.service.com/api");
        return r;
    }

    // WARN (HTTP prefix): prefix survives concatenation
    // base starts with "https://", appending "/transfer"
    // keeps the prefix → still detected
    testHttpsConcat() {
        def base = "https://secure.bank.com";
        def url = base + "/transfer";
        def r = this.fetch(url);
        return r;
    }

    // NO WARN (HTTP prefix): ftp:// does not start with http(s)://
    testFtpNoWarn() {
        def r = this.fetch("ftp://files.internal/report.csv");
        return r;
    }

    // WARN (suffix .com): "google.com" ends with ".com"
    testDotComDirect() {
        def r = this.resolve("google.com");
        return r;
    }

    // WARN (suffix .com): email address ending in ".com"
    testDotComEmail() {
        def r = this.sendEmail("user@company.com", "Hello!");
        return r;
    }

    // WARN (both checkers): url starts with "https://" AND ends with ".com"
    // HTTPStringChecker fires on fetch (prefix)
    // DotComStringChecker fires on resolve (suffix)
    testBothCheckers() {
        def url = "https://www.amazon.com";
        def r = this.fetch(url);
        def s = this.resolve(url);
        return r;
    }

    // NO WARN (either checker): ".org" not ".com", no http prefix
    testOrgNoWarn() {
        def r = this.resolve("wikipedia.org");
        return r;
    }

    // WARN (prefix only): https but not .com suffix
    testHttpsOrgMixed() {
        def url = "https://university.edu";
        def r = this.fetch(url);
        return r;
    }

    // NO WARN: prefix is lost when something is prepended before the URL
    // prefix becomes "PREFIX..." not "http..."
    testPrefixLost() {
        def prefix = "REDIRECT:";
        def url = prefix + "http://example.com";
        def r = this.fetch(url);   // NO WARN: prefix is "REDIRECT:..."
        return r;
    }
}