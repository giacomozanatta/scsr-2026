class WebClient {

    /*
     * Scope: static, fully-known string literals only.
     * No concatenation, no parameters, no branches, no loops.
     * Purpose: establish ground-truth prefix/suffix detection from
     * complete URLs where both domains see the full string.
     * Every expected result here is deterministic and unambiguous.
     *
     * Methods are organized in four groups:
     *   A) PREFIX only  — http/https URLs whose path/extension kills the suffix
     *   B) SUFFIX only  — non-http protocols ending in .com, and bare domains
     *   C) BOTH         — http/https URLs that also end exactly in .com
     *   D) NEITHER      — non-http, non-.com, or local resources
     */


    /* ------------------------------------------------------------------ */
    /* GROUP A — PREFIX checker fires, SUFFIX checker does NOT            */
    /* ------------------------------------------------------------------ */

    /*
     * http URL ending with an HTML page.
     * prefix = "http://example.com/index.html" -> starts with "http://"
     * suffix = "http://example.com/index.html" -> ends with ".html", NOT ".com"
     *
     * PREFIX  checker: WARN  — starts with "http://"
     * SUFFIX  checker: no warn — ends with ".html"
     */
    getHomePage() {
        def url = "http://example.com/index.html";
        this.fetch(url);
    }

    /*
     * https URL ending with a REST endpoint path segment.
     * prefix = "https://api.example.com/users" -> starts with "https://"
     * suffix = "https://api.example.com/users" -> ends with "/users", NOT ".com"
     *
     * PREFIX  checker: WARN  — starts with "https://"
     * SUFFIX  checker: no warn — ends with "/users"
     */
    getUsers() {
        def url = "https://api.example.com/users";
        this.fetch(url);
    }

    /*
     * https URL with a .net domain — not .com.
     * prefix starts with "https://", suffix ends with ".net".
     *
     * PREFIX  checker: WARN  — starts with "https://"
     * SUFFIX  checker: no warn — ends with ".net"
     */
    fetchHttpsNet() {
        def url = "https://api.example.net";
        this.fetch(url);
    }

    /*
     * ftp URL with a .net domain.
     * prefix = "ftp://files.example.net" -> does NOT start with "http(s)://"
     * suffix = "ftp://files.example.net" -> ends with ".net", NOT ".com"
     *
     * PREFIX  checker: no warn — starts with "ftp://" (wrong scheme)
     * SUFFIX  checker: no warn — ends with ".net"
     *
     * Included in group A because it is a protocol-mismatch control case
     * for the prefix checker alongside the http/https positives above.
     */
    fetchFtpNet() {
        def url = "ftp://files.example.net";
        this.fetch(url);
    }


    /* ------------------------------------------------------------------ */
    /* GROUP B — SUFFIX checker fires, PREFIX checker does NOT            */
    /* ------------------------------------------------------------------ */

    /*
     * ftp URL with a .com domain.
     * prefix = "ftp://files.example.com" -> does NOT start with "http(s)://"
     * suffix = "ftp://files.example.com" -> ends with ".com"
     *
     * PREFIX  checker: no warn — starts with "ftp://"
     * SUFFIX  checker: WARN  — ends with ".com"
     */
    fetchFtpCom() {
        def url = "ftp://files.example.com";
        this.fetch(url);
    }

    /*
     * DNS resolution with a bare .com domain (no scheme at all).
     * prefix = "example.com" -> does NOT start with "http(s)://"
     * suffix = "example.com" -> ends with ".com"
     *
     * PREFIX  checker: no warn — no http(s):// prefix
     * SUFFIX  checker: WARN  — ends with ".com"
     */
    resolveDotCom() {
        def domain = "example.com";
        this.resolve(domain);
    }

    /*
     * DNS resolution with a bare .net domain (no scheme).
     * prefix = "example.net" -> does NOT start with "http(s)://"
     * suffix = "example.net" -> ends with ".net", NOT ".com"
     *
     * PREFIX  checker: no warn — no http(s):// prefix
     * SUFFIX  checker: no warn — ends with ".net"
     *
     * Control case for resolveDotCom: same pattern, different TLD, no warn.
     */
    resolveDotNet() {
        def domain = "example.net";
        this.resolve(domain);
    }


    /* ------------------------------------------------------------------ */
    /* GROUP C — BOTH checkers fire                                        */
    /* ------------------------------------------------------------------ */

    /*
     * Full http URL ending exactly in .com.
     *
     * PREFIX  checker: WARN — starts with "http://"
     * SUFFIX  checker: WARN — ends with ".com"
     */
    fetchHttpCom() {
        def url = "http://example.com";
        this.fetch(url);
    }

    /*
     * Full https URL ending exactly in .com.
     *
     * PREFIX  checker: WARN — starts with "https://"
     * SUFFIX  checker: WARN — ends with ".com"
     */
    fetchHttpsCom() {
        def url = "https://example.com";
        this.fetch(url);
    }


    /* ------------------------------------------------------------------ */
    /* GROUP D — NEITHER checker fires                                     */
    /* ------------------------------------------------------------------ */

    /*
     * Local file path — no scheme, no .com.
     *
     * PREFIX  checker: no warn
     * SUFFIX  checker: no warn
     */
    fetchLocal() {
        def path = "/local/resource/data";
        this.fetch(path);
    }

    /*
     * Internal service address — no http(s) scheme, no .com.
     *
     * PREFIX  checker: no warn
     * SUFFIX  checker: no warn
     */
    fetchInternal() {
        def addr = "internal-service:8080/health";
        this.fetch(addr);
    }


    /* ------------------------------------------------------------------ */
    /* Sink / helper stubs                                                 */
    /* ------------------------------------------------------------------ */

    fetch(url) {
        return url;
    }

    resolve(domain) {
        return domain;
    }
}


class ApiGateway {

    /*
     * Scope: URL construction by string concatenation, branch joins,
     * and dispatch through intermediate variables.
     * No fully-static literals passed directly to sinks — those belong to WebClient.
     * Purpose: stress-test what the prefix and suffix domains compute when
     * the string is partially or wholly unknown at analysis time, and what
     * survives (or is lost) at branch join points.
     *
     * Groups:
     *   A) Concatenation — one part known, one part unknown parameter
     *   B) Branch joins  — what prefix/suffix survives the join operator
     *   C) Interprocedural dispatch chains
     */


    /* ------------------------------------------------------------------ */
    /* GROUP A — STRING CONCATENATION                                      */
    /* ------------------------------------------------------------------ */

    /*
     * Scheme known ("https://"), host is an unknown parameter.
     * "https://" + host  ->  prefix = "https://",  suffix = top
     *
     * PREFIX  checker: WARN  — prefix "https://"
     * SUFFIX  checker: no warn — suffix is top (unknown end)
     */
    dispatchKnownSchemeUnknownHost(host) {
        def url = "https://" + host;
        this.dispatch(url);
    }

    /*
     * Host unknown, ".com" appended as a literal.
     * host + ".com"  ->  prefix = top,  suffix = ".com"
     *
     * PREFIX  checker: no warn — prefix is top (unknown start)
     * SUFFIX  checker: WARN  — suffix ".com"
     */
    dispatchUnknownHostDotCom(host) {
        def url = host + ".com";
        this.dispatch(url);
    }

    /*
     * Full construction: known scheme + unknown host + known ".com".
     * "https://" + host + ".com"  ->  prefix = "https://",  suffix = ".com"
     *
     * PREFIX  checker: WARN  — prefix "https://"
     * SUFFIX  checker: WARN  — suffix ".com"
     */
    dispatchFullConstruction(host) {
        def scheme = "https://";
        def url    = scheme + host + ".com";
        this.dispatch(url);
    }

    /*
     * Versioned endpoint: known base + unknown version number.
     * "https://api.example.com/v" + version
     * prefix = "https://api.example.com/v" -> starts with "https://"
     * suffix = top (version unknown -> unknown end)
     *
     * PREFIX  checker: WARN  — prefix starts with "https://"
     * SUFFIX  checker: no warn — suffix is top
     */
    dispatchVersionedEndpoint(version) {
        def base     = "https://api.example.com/v";
        def endpoint = base + version;
        this.dispatch(endpoint);
    }

    /*
     * Subdomain construction: known scheme + unknown subdomain + known root domain.
     * "https://" + subdomain + ".example.com"
     * prefix = "https://",  suffix = ".example.com" (ends with ".com")
     *
     * PREFIX  checker: WARN  — prefix "https://"
     * SUFFIX  checker: WARN  — suffix ends with ".com"
     */
    dispatchSubdomain(subdomain) {
        def url = "https://" + subdomain + ".example.com";
        this.dispatch(url);
    }

    /*
     * All three parts unknown — scheme, host and path are all parameters.
     * prefix = top,  suffix = top
     *
     * PREFIX  checker: no warn — prefix is top
     * SUFFIX  checker: no warn — suffix is top
     */
    dispatchFullyUnknown(scheme, host, path) {
        def url = scheme + host + path;
        this.dispatch(url);
    }


    /* ------------------------------------------------------------------ */
    /* GROUP B — BRANCH JOINS                                              */
    /* ------------------------------------------------------------------ */

    /*
     * Both branches produce https .com URLs sharing "https://api." prefix
     * and ".com" suffix. The join preserves both.
     * "https://api.prod.com" vs "https://api.staging.com"
     * Joined prefix = "https://api." -> still starts with "https://"
     * Joined suffix = ".com"
     *
     * PREFIX  checker: WARN  — joined prefix starts with "https://"
     * SUFFIX  checker: WARN  — joined suffix ".com"
     */
    dispatchByEnvironment(isProd) {
        def url = "https://api.staging.com";
        if (isProd)
            url = "https://api.prod.com";
        else
            url = "https://api.staging.com";
        this.dispatch(url);
    }

    /*
     * One branch is https, the other is http.
     * "https://secure.example.com" vs "http://legacy.example.com"
     * Longest common prefix = "http" — does NOT satisfy startsWith("http://")
     * because it is missing "://".
     * Joined suffix = ".com"
     *
     * PREFIX  checker: no warn — joined prefix "http" lacks "://"
     * SUFFIX  checker: WARN  — joined suffix ".com"
     *
     * Key subtlety: both strings individually trigger the prefix checker,
     * but the join loses the distinction between "http://" and "https://".
     */
    dispatchByProtocol(useSecure) {
        def url = "http://legacy.example.com";
        if (useSecure)
            url = "https://secure.example.com";
        else
            url = "http://legacy.example.com";
        this.dispatch(url);
    }

    /*
     * One branch is an https .com URL, the other is an internal address.
     * "https://api.example.com" vs "internal-service:9090"
     * Joined prefix = "" -> top (no common prefix)
     * Joined suffix = top (no common suffix)
     *
     * PREFIX  checker: no warn — prefix lost at join
     * SUFFIX  checker: no warn — suffix lost at join
     */
    dispatchOrInternal(useExternal) {
        def url = "internal-service:9090";
        if (useExternal)
            url = "https://api.example.com";
        else
            url = "internal-service:9090";
        this.dispatch(url);
    }


    /* ------------------------------------------------------------------ */
    /* GROUP C — INTERPROCEDURAL DISPATCH CHAINS                          */
    /* ------------------------------------------------------------------ */

    /*
     * Delegates to dispatchVersionedEndpoint.
     * Warning fires inside callee at its dispatch call site.
     *
     * PREFIX  checker: WARN (inside dispatchVersionedEndpoint -> dispatch)
     * SUFFIX  checker: no warn
     */
    proxyVersionedCall(version) {
        this.dispatchVersionedEndpoint(version);
    }

    /*
     * Same constructed .com URL passed to two successive call sites.
     * "https://payments.example.com" — both calls see identical prefix/suffix.
     * Tests that the checker fires independently at each call site.
     *
     * PREFIX  checker: WARN on validate AND WARN on dispatch
     * SUFFIX  checker: WARN on validate AND WARN on dispatch
     */
    validateThenDispatch() {
        def url = "https://payments.example.com";
        this.validate(url);
        this.dispatch(url);
    }


    /* ------------------------------------------------------------------ */
    /* Sink / helper stubs                                                 */
    /* ------------------------------------------------------------------ */

    dispatch(url) {
        return url;
    }

    validate(url) {
        return url;
    }

    redirect(target) {
        return target;
    }
}


class Mailer {

    /*
     * Scope: edge cases and non-obvious checker behavior.
     * Unique scenarios not covered by WebClient (static literals) or
     * ApiGateway (concatenation + branch joins on URL structure):
     *
     *   A) Path segment after .com destroys the suffix match
     *   B) Non-URL strings that syntactically trigger the suffix rule
     *      (email addresses, display name headers)
     *   C) Loop-built URLs — prefix stability vs suffix loss across iterations
     *   D) String reassignment before the sink — checker sees the final value
     */


    /* ------------------------------------------------------------------ */
    /* GROUP A — PATH SEGMENT AFTER .com DESTROYS SUFFIX MATCH            */
    /* ------------------------------------------------------------------ */

    /*
     * Unknown base + ".com/unsubscribe" — path after .com kills the suffix.
     * suffix = ".com/unsubscribe" -> endsWith(".com") is FALSE.
     *
     * PREFIX  checker: no warn — prefix is top
     * SUFFIX  checker: no warn — suffix is ".com/unsubscribe", not ".com"
     *
     * Contrast with sendDotComOnly: one extra path segment is enough to
     * silence the suffix checker entirely.
     */
    sendUnsubscribeLink(base) {
        def link = base + ".com/unsubscribe";
        this.sendEmail(link);
    }

    /*
     * Tracking pixel URL: known http base + unknown tracking id appended.
     * "http://track.mailer.com/open?id=" + trackingId
     * prefix = "http://track.mailer.com/open?id=" -> starts with "http://"
     * suffix = top (trackingId unknown -> unknown end)
     *
     * PREFIX  checker: WARN  — prefix "http://"
     * SUFFIX  checker: no warn — suffix is top
     */
    sendTrackedPixel(trackingId) {
        def pixel = "http://track.mailer.com/open?id=" + trackingId;
        this.sendEmail(pixel);
    }


    /* ------------------------------------------------------------------ */
    /* GROUP B — NON-URL STRINGS THAT MATCH SYNTACTICALLY                 */
    /* ------------------------------------------------------------------ */

    /*
     * Plain recipient email address: "user@example.com"
     * prefix = "user@example.com" -> does NOT start with "http(s)://"
     * suffix = "user@example.com" -> ends with ".com"
     *
     * PREFIX  checker: no warn — not an http(s) URL
     * SUFFIX  checker: WARN  — ends with ".com" (purely syntactic)
     *
     * Canonical example of the checker being domain-unaware:
     * email addresses fire the suffix rule even though they are not URLs.
     */
    sendToEmailAddress() {
        def recipient = "user@example.com";
        this.sendEmail(recipient);
    }

    /*
     * RFC 5322 display name header: "John Doe <john@company.com>"
     * suffix = "John Doe <john@company.com>" -> ends with ".com>", NOT ".com"
     * The closing angle bracket after .com prevents the suffix match.
     *
     * PREFIX  checker: no warn
     * SUFFIX  checker: no warn — ">" after .com kills the suffix match
     */
    sendWithDisplayName() {
        def header = "John Doe <john@company.com>";
        this.sendEmail(header);
    }

    /*
     * Reply-to header ending in .net — not .com.
     *
     * PREFIX  checker: no warn
     * SUFFIX  checker: no warn — ends with ".net"
     */
    sendReplyTo() {
        def replyTo = "noreply@service.net";
        this.sendEmail(replyTo);
    }


    /* ------------------------------------------------------------------ */
    /* GROUP C — LOOP-BUILT URLS                                          */
    /* ------------------------------------------------------------------ */

    /*
     * Each iteration appends the loop counter to a known http base.
     * "http://track.mailer.com/?id=" + i
     * prefix is stable across iterations -> "http://track.mailer.com/?id="
     * suffix = top (i is numeric, changes each iteration, unknown after widening)
     *
     * PREFIX  checker: WARN on sendEmail inside loop — prefix "http://"
     * SUFFIX  checker: no warn — suffix is top after widening
     */
    sendBulkTracked(n) {
        def i = 0;
        while (i < n) {
            def url = "http://track.mailer.com/?id=" + "i"; // seems stupid but this doesn't seem to handle concatenating different types without making the variables fall into a BOTTOM state so let's count with "i"s appended
            this.sendEmail(url);
            i = i + 1;
        }
    }

    /*
     * Each iteration uses a fully static .com URL — no per-iteration unknown.
     * Prefix and suffix are identical every iteration.
     *
     * PREFIX  checker: WARN on sendEmail inside loop — prefix "https://"
     * SUFFIX  checker: WARN on sendEmail inside loop — suffix ".com"
     */
    sendBulkStatic(n) {
        def i = 0;
        while (i < n) {
            def url = "https://newsletter.mailer.com";
            this.sendEmail(url);
            i = i + 1;
        }
    }

    /* ------------------------------------------------------------------ */
    /* GROUP D — STRING REASSIGNMENT BEFORE THE SINK                      */
    /* ------------------------------------------------------------------ */

    /*
     * The http .com URL is overwritten with a local path before the call.
     * The sink only ever sees the local path — not the original URL.
     *
     * PREFIX  checker: no warn — final value "/local/unsubscribe"
     * SUFFIX  checker: no warn — final value has no .com suffix
     */
    sendReassigned() {
        def url = "https://click.mailer.com";
        url = "/local/unsubscribe";
        this.sendEmail(url);
    }

    /*
     * URL passed to sink before reassignment (warn), then reassigned
     * and passed again (no warn). Tests that the checker tracks the
     * value at each individual call site, not the variable's lifetime.
     *
     * PREFIX  checker: WARN on first sendEmail, no warn on second
     * SUFFIX  checker: WARN on first sendEmail, no warn on second
     */
    sendBeforeAndAfterReassign() {
        def url = "https://click.mailer.com";
        this.sendEmail(url);
        url = "/local/fallback";
        this.sendEmail(url);
    }


    /* ------------------------------------------------------------------ */
    /* Sink / helper stubs                                                 */
    /* ------------------------------------------------------------------ */

    sendEmail(content) {
        return content;
    }

    log(msg) {
        return msg;
    }
}