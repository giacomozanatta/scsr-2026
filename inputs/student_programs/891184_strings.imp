/* This is just a set of test to see how the checker handles different cases.
 * It resembles how someone might dynamically assemble API urls
 * To actually trigger the check the value must bue used as a parameter in a
 * a function call, so we use Main.fetchData()
 */

class StringBuilder {

	apiUrl;
	backupApiUrl1;
	backupApiUrl2;
	backupApiUrl2;

	~StringBuilder() {
		this.apiUrl = "https://example.com";
		this.backupApiUrl1 = "https://example.org";
		this.backupApiUrl2 = "ssh://example.com";
		this.backupApiUrl2 = "ws://example.dev";
	}

	buildUrl(h, t, p, s, hostname, com) {
		def url = "";
		if (h == true) {
			url = url + "h";
		} else {
			url = url + "ws";
		}
		if (t == true) {
			url = url + "tt";
		}
		if (p == true) {
			url = url + "p";
		}
		if (s == true) {
			url = url + "s";
		}
		url = url + "://" + hostname;
		if (com == true) {
			url = url + ".com";
		} else {
			url = url + ".org";
		}
		return url;
	}
}

class Main {
	sb;

	~Main() {
		this.sb = new StringBuilder();
	}

	fetchData(url) {
		return true;
	}

	test1() {
		def sb = this.sb;
		def a = sb.buildUrl(true, true, false, false, "example", true);
		def b = sb.buildUrl(true, true, false, false, "example", false);
		def c = sb.buildUrl(true, true, true, true, "example", false);
		def d = sb.buildUrl(false, false, false, false, "example", true);
		this.fetchData(a);
		this.fetchData(b);
		this.fetchData(c);
		this.fetchData(d);
	}

	test2() {
		def a = "htfootps://example.colm";
		this.fetchData(a);
		a = strsub(a, 0, 2) + strsub(a, 5, 23); // "https://example.colm"
		this.fetchData(a);
		a = strsub(a, 0, 18) + strsub(a, 19, 20);
		this.fetchData(a);
	}
}