// Generated by Cursor
// Scenario: disk block allocator divides by user-supplied block size

class BlockAllocator {

	enabled;
	blockSize;

	init(size) {
		this.enabled = 1;
		this.blockSize = size;
	}

	disable() {
		this.enabled = 0;
		this.blockSize = 0;
	}

	computeBlocks(fileSize) {
		if (this.enabled) {
			def blocks = fileSize / this.blockSize;
			return blocks;
		}
		return 1;
	}
}
