// Generated by Cursor
// Scenario: mesh tessellation splits edge by segment count

class MeshTessellator {

	edgeLength(totalLength, segments) {
		def step = totalLength / segments;
		return step;
	}

	edgeLengthChecked(totalLength, segments) {
		def step = 0;
		if (segments > 0)
			step = totalLength / segments;
		return step;
	}
}
