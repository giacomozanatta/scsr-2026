// Generated by Cursor
// Scenario: pagination divides item count by page size from config

class Paginator {

	pageSize;

	setPageSize(size) {
		this.pageSize = size;
	}

	pageCount(itemCount) {
		def pages = itemCount / this.pageSize;
		return pages;
	}

	resetConfig() {
		this.pageSize = 0;
	}
}
