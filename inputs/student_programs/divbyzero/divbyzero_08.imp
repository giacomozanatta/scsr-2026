// Generated by Cursor
// Scenario: PID controller divides error by integral term that may vanish

class PidController {

	computeGain(error, integral) {
		def gain = error / integral;
		return gain;
	}

	computeGainSafe(error, integral) {
		def gain = 0;
		if (integral > 0)
			gain = error / integral;
		else if (integral < 0)
			gain = error / integral;
		return gain;
	}
}
