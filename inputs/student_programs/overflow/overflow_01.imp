// Generated by Cursor
// Scenario: e-commerce cart total exceeds 32-bit signed range in a flash-sale loop

class CartTotalAccumulator {

	addItem(price, quantity) {
		return price * quantity;
	}

	flashSaleTotal(n, unitPrice) {
		def total = 0;
		def i = 0;
		while (i < n) {
			total = total + unitPrice;
			i = i + 1;
		}
		return total;
	}

	applyBulkDiscount(total, discountPercent) {
		def discounted = total - (total * discountPercent / 100);
		return discounted;
	}
}
