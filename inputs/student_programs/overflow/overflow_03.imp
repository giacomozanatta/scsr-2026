// Generated by Cursor
// Scenario: telemetry counter underflow when subtracting large baseline

class TelemetryCounter {

	reset() {
		return 0;
	}

	subtractBaseline(reading, baseline) {
		def adjusted = reading - baseline;
		return adjusted;
	}

	rollingDelta(current, previous) {
		def delta = current - previous;
		if (delta < 0)
			delta = 0 - delta;
		return delta;
	}
}
