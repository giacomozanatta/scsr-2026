// Generated by Cursor
// Scenario: audio sample pipeline scales amplitudes beyond representable range

class AudioGainStage {

	applyGain(sample, gain) {
		return sample * gain;
	}

	mixTracks(t1, t2, t3) {
		def mixed = t1 + t2;
		mixed = mixed + t3;
		return mixed;
	}

	compressPeaks(peak, threshold) {
		if (peak > threshold)
			peak = peak - threshold;
		return peak;
	}
}
