// Generated by Cursor
// Scenario: game score multiplier chain in bonus round

class ScoreEngine {

	addPoints(score, points) {
		return score + points;
	}

	bonusRound(score, multiplier, bonus) {
		def boosted = score * multiplier;
		return boosted + bonus;
	}

	comboChain(s1, s2, s3, s4) {
		def combo = s1 + s2;
		combo = combo + s3;
		combo = combo + s4;
		return combo;
	}
}
