// Generated by Cursor
// Scenario: network byte counter in high-throughput capture loop

class PacketByteCounter {

	countFrame(headerLen, payloadLen) {
		return headerLen + payloadLen;
	}

	accumulateBurst(n, frameSize) {
		def bytes = 0;
		def i = 0;
		while (i < n) {
			bytes = bytes + frameSize;
			i = i + 1;
		}
		return bytes;
	}

	wrapAdjust(total, maxWindow) {
		def remainder = total - maxWindow;
		return remainder;
	}
}
