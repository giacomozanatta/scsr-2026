// Generated by Cursor
// Scenario: webhook dispatcher selects HTTP or HTTPS endpoint at runtime

class WebhookDispatcher {

	deliver(url) {
		return url;
	}

	dispatch(useTls, eventId) {
		def url = "ftp://neutral.load/";
		if (useTls)
			url = "https://hooks.down.load/" + eventId;
		else
			url = "http://hooks.down.load/" + eventId;
		return this.deliver(url);
	}
}
