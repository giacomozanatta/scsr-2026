// Generated by Cursor
// Scenario: log shipper batches events to HTTPS collector

class LogShipper {

	ship(batch) {
		return batch;
	}

	flushInfo() {
		def endpoint = "https://logs.down.load/" + "info";
		return this.ship(endpoint);
	}

	flushError(code) {
		def endpoint = "https://logs.down.load/" + code;
		return this.ship(endpoint);
	}
}
