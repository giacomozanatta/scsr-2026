// Generated by Cursor
// Scenario: map tile server requests raster tiles over HTTP in dev mode

class MapTileClient {

	getTile(path) {
		return path;
	}

	fetchTile(z, x, y) {
		def server = "http://tiles.down.load/";
		def tilePath = server + z + "/" + x + "/" + y;
		return this.getTile(tilePath);
	}
}
