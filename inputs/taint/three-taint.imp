class UserAuthentication {

    /*
     * Sources   : GetRequest
     * Sanitizers: hashPassword, validateUsername
     * Sinks     : runQueryDB, storeSession, logAudit
     *
     * Taint flow summary per method — see inline comments.
     */

    /*
     * Direct taint into a sink: no sanitization at all.
     * username <- GetRequest()        : TAINT
     * runQueryDB(username)            : TAINT flows into sink
     *
     * EXPECT: definite warning on runQueryDB(username)
     */
    loginUnsafe() {
        def username = this.GetRequest();
        def password = this.GetRequest();
        this.runQueryDB(username);
    }

    /*
     * Both inputs sanitized before the sink.
     * username <- validateUsername(GetRequest()) : CLEAN
     * password <- hashPassword(GetRequest())     : CLEAN
     * runQueryDB(username)                       : CLEAN into sink
     *
     * EXPECT: no warning
     */
    loginSafe() {
        def rawUser = this.GetRequest();
        def rawPass = this.GetRequest();
        def username = this.validateUsername(rawUser);
        def password = this.hashPassword(rawPass);
        this.runQueryDB(username);
    }

    /*
     * Taint propagates through an intermediate variable.
     * raw      <- GetRequest()  : TAINT
     * trimmed   = raw           : TAINT  (assignment propagates taint)
     * query     = trimmed       : TAINT
     * runQueryDB(query)         : TAINT into sink
     *
     * EXPECT: definite warning on runQueryDB(query)
     */
    loginWithAlias() {
        def raw     = this.GetRequest();
        def trimmed = raw;
        def query   = trimmed;
        this.runQueryDB(query);
    }

    /*
     * Branch: tainted on one path, sanitized on the other.
     * After join: TAINT ⊔ CLEAN = TOP
     * storeSession(token)  : TOP into sink
     *
     * EXPECT: possible warning on storeSession(token)
     */
    loginConditionalSanitization(isAdmin) {
        def raw   = this.GetRequest();
        def token = raw;
        if (isAdmin)
            token = this.validateUsername(raw);
        else
            token = raw;
        this.storeSession(token);
    }

    /*
     * Branch: tainted on both paths (different sources, same taint level).
     * TAINT ⊔ TAINT = TAINT
     * storeSession(token)  : TAINT into sink
     *
     * EXPECT: definite warning on storeSession(token)
     */
    loginAlwaysTainted(isAdmin) {
        def token = this.GetRequest();
        if (isAdmin)
            token = this.GetRequest();
        else
            token = this.GetRequest();
        this.storeSession(token);
    }

    /*
     * Branch: sanitized on both paths.
     * CLEAN ⊔ CLEAN = CLEAN
     * storeSession(token)  : CLEAN into sink
     *
     * EXPECT: no warning
     */
    loginAlwaysSanitized(isAdmin) {
        def raw   = this.GetRequest();
        def token = raw;
        if (isAdmin)
            token = this.hashPassword(raw);
        else
            token = this.validateUsername(raw);
        this.storeSession(token);
    }

    /* Tries to login within n attempts
     * Taint survives a loop: username is re-fetched every iteration.
     * runQueryDB(username) inside loop: TAINT into sink.
     *
     * EXPECT: definite warning on runQueryDB(username) inside loop
     */
    loginWithRetries(n) {
        def i        = 0;
        def username = this.GetRequest();
        while (i < n) {
            username = this.GetRequest();
            this.runQueryDB(username);
            i = i + 1;
        }
    }

    /* Tries to login within n attempts
     * Sanitization happens before the loop, value is CLEAN inside it.
     * runQueryDB(safe) inside loop: CLEAN into sink.
     *
     * EXPECT: no warning
     */
    loginWithRetriesSafe(n) {
        def raw  = this.GetRequest();
        def safe = this.validateUsername(raw);
        def i    = 0;
        while (i < n) {
            this.runQueryDB(safe);
            i = i + 1;
        }
    }

    /*
     * Interprocedural: calls loginUnsafe which internally calls runQueryDB
     * with a tainted value. The warning is emitted at the call site inside
     * loginUnsafe, visible when analyzing this method as entry point.
     *
     * EXPECT: definite warning (propagated from loginUnsafe -> runQueryDB)
     */
    adminLogin() {
        this.loginUnsafe();
    }

    /*
     * Taint reaches two sinks: runQueryDB and logAudit.
     * raw <- GetRequest() : TAINT
     * Both sinks receive the raw value.
     *
     * EXPECT: definite warning on runQueryDB(raw) AND on logAudit(raw)
     */
    loginAndLog() {
        def raw = this.GetRequest();
        this.runQueryDB(raw);
        this.logAudit(raw);
    }

    /*
     * Sanitized value reaching a sink, with an additional unsanitized log.
     * safe  <- validateUsername(GetRequest()) : CLEAN -> runQueryDB: no warn
     * raw   <- GetRequest()                   : TAINT -> logAudit: warn
     *
     * EXPECT: no warning on runQueryDB(safe)
     *         definite warning on logAudit(raw)
     */
    loginSafeQueryUnsafeLog() {
        def raw  = this.GetRequest();
        def safe = this.validateUsername(raw);
        def raw2 = this.GetRequest();
        this.runQueryDB(safe);
        this.logAudit(raw2);
    }

    /*
     * Dummy implementations of sources, sanitizers, sinks.
     * The test harness registers these names — the bodies are irrelevant.
     */
    GetRequest() {
        def result = "input";
        return result;
    }

    validateUsername(u) {
        return u;
    }

    hashPassword(p) {
        return p;
    }

    runQueryDB(q) {
        return q;
    }

    storeSession(s) {
        return s;
    }

    logAudit(msg) {
        return msg;
    }
}

class SQLInjection {

    /* Use-case where a user would input something on an interface to execute a database query
     * We must prevent unwanted SQL injections (drop entries or reveal secrets...) by sanitizing the input first.
     * Taint analysis comes in to keep track of unsafe inputs.
     * Sources   : readUserInput, readCookie
     * Sanitizers: escapeSQL, parameterize
     * Sinks     : executeQuery, executeUpdate
     *
     * Focus of this class :
     * - Check if interprocedural calls and wrappers on sinks, sanitizers,
     * and the variable itself correctly propagates abstract values
     * - Taint passed through return value of a non-sanitizer method
     * - Nested branches producing TOP at the join
     * - Re-taint after sanitization (sanitization overwritten before sink)
     * - Loop where sanitization happens *inside* the loop body before sink
     */

    /*
     * Interprocedural — the *caller* taints the argument.
     * tainted parameter `q` reaches executeQuery directly.
     *
     * EXPECT: POSSIBLE WARNING on runQuery
     */
    runQuery(q) {
        def sql =
            "SELECT * FROM users WHERE username = '" +
            q +
            "'";
        this.executeQuery(sql);
    }

    /*
     * Caller side that passes TAINT into runQuery.
     * runQuery -> executeQuery(q) receives a TAINTED q.
     *
     * EXPECT: definite warning propagated through runQuery to executeQuery.
     */
    searchUserByName() {
        def name = this.readUserInput();
        this.runQuery(name);
    }

    /*
     * Same wrapper, but caller sanitizes first.
     * runQuery(q) receives CLEAN, executeQuery(q) is safe in this context.
     *
     * EXPECT: no warning when entry point is this method.
     * (Note: if the analyzer is purely intraprocedural-context-insensitive,
     *  runQuery alone might still warn — this tests context sensitivity.)
     */
    searchUserByNameSafe() {
        def raw  = this.readUserInput();
        def safe = this.escapeSQL(raw);
        this.runQuery(safe);
    }

    /*
     * Laundering wrapper: returns a sanitized value.
     * The return of cleanse() is CLEAN, so the sink is safe.
     *
     * EXPECT: no warning on executeQuery(clean).
     */
    cleanse(x) {
        def y = this.escapeSQL(x);
        return y;
    }

    deleteRecordSafe() {
        def raw   = this.readUserInput();
        def clean = this.cleanse(raw);
        this.executeUpdate(clean);
    }

    /*
     * Identity wrapper: returns its argument unchanged.
     * Taint must propagate through the return.
     * passthrough(raw) is still TAINT.
     *
     * EXPECT: definite warning on executeUpdate(dirty).
     */
    passthrough(x) {
        return x;
    }

    deleteRecordUnsafe() {
        def raw   = this.readUserInput();
        def dirty = this.passthrough(raw);
        this.executeUpdate(dirty);
    }

    /*
     * Re-taint: variable is sanitized, then reassigned to a fresh source
     * before reaching the sink. The earlier sanitization must NOT carry over.
     *
     * EXPECT: definite warning on executeQuery(q).
     */
    reTaintCase() {
        def raw = this.readUserInput();
        def q   = this.escapeSQL(raw);
        q = this.readCookie();
        this.executeQuery(q);
    }

    /*
     * Sanitization happens inside the loop body before the sink each iter.
     * Even though the source is fetched fresh inside the loop, sanitization
     * dominates the sink on every path through it.
     *
     * EXPECT: no warning on executeUpdate(safe).
     */
    batchUpdateSafe(n) {
        def i = 0;
        while (i < n) {
            def raw  = this.readUserInput();
            def safe = this.parameterize(raw);
            this.executeUpdate(safe);
            i = i + 1;
        }
    }

    /*
     * Nested branches: only one of four paths is sanitized.
     * Join over all paths: TAINT ⊔ TAINT ⊔ TAINT ⊔ CLEAN = TOP.
     *
     * EXPECT: possible warning on executeQuery(q).
     */
    nestedBranches(a, b) {
        def raw = this.readUserInput();
        def q   = raw;
        if (a) {
            if (b)
                q = this.escapeSQL(raw);
            else
                q = raw;
        }
        else {
            if (b)
                q = this.readCookie();
            else
                q = raw;
        }
        this.executeQuery(q);
    }

    /* Sources / Sanitizers / Sinks */

    readUserInput() {
        def r = "' OR 1=1 --";
        return r;
    }

    readCookie() {
        def r = "admin' --";
        return r;
    }

    escapeSQL(s) {
        return "[ESCAPED]" + s;
    }

    parameterize(s) {
        return "[PARAM]" + s;
    }

    executeQuery(q) {
        return q;
    }

    executeUpdate(q) {
        def sql =
            "DELETE FROM accounts WHERE owner = '" +
            q +
            "'";
        return sql;
    }
}

class PaymentProcessor {

    /*
     * Sources   : getCardNumber, getCVV, getBillingAddress
     * Sanitizers: tokenizeCard, normalizeAddress
     * Sinks     : chargeCard, sendToGateway, persistTransaction
     *
     * Focus of this class: cases that stress multi-source / multi-sink
     * interactions and sanitizer specificity.
     * - Multiple distinct sources reaching the same sink
     * - Loop where one iteration sanitizes "too late" (sink before sanitizer)
     * - A sink fed by a chain: source -> wrapper -> wrapper -> sink
     */

    /*
     * Two different sources, both tainted, flowing into one sink as
     * separate arguments-equivalent calls. Tests independence of each call.
     *
     * EXPECT: definite warning on chargeCard(card)
     *         definite warning on chargeCard(cvv)
     */
    loadCardUnsafe() {
        def card = this.getCardNumber();
        def cvv  = this.getCVV();
        this.chargeCard(card);
        this.chargeCard(cvv);
    }

    /*
     * Loop where the sink is hit BEFORE the sanitizer on the first iteration.
     * On entry: card is TAINT, sink hit with TAINT.
     * Then sanitized. Next iteration: sink hit with CLEAN.
     * Across all iterations: at least one TAINT reach => fixed-point holds TOP
     * at the sink statement.
     *
     * EXPECT: possible warning on chargeCard(card) inside the loop.
     */
    sanitizeTooLate(n) {
        def card = this.getCardNumber();
        def i    = 0;
        while (i < n) {
            this.chargeCard(card);
            card = this.tokenizeCard(card);
            i = i + 1;
        }
    }

    /*
     * Chain of wrappers, no sanitization anywhere along the way.
     * source -> stageOne -> stageTwo -> sink.
     *
     * EXPECT: definite warning on sendToGateway inside stageTwo
     *         (visible from processPaymentChained).
     */
    stageOne(x) {
        def y = x;
        this.stageTwo(y);
    }

    stageTwo(x) {
        this.sendToGateway(x);
    }

    processPaymentChained() {
        def card = this.getCardNumber();
        this.stageOne(card);
    }

    /*
     * Same chain, but sanitization happens before entering it.
     *
     * EXPECT: no warning on sendToGateway in stageTwo when entered via this method.
     *         (Tests context-sensitivity again, on a deeper chain.)
     */
    processPaymentChainedSafe() {
        def raw = this.getCardNumber();
        def tok = this.tokenizeCard(raw);
        this.stageOne(tok);
    }

    /*
     * Mixed: one sink gets a fully-sanitized value via a long chain,
     * another sink in the same method gets a raw value.
     * Verifies that sanitization on one path does not "infect" other sinks.
     *
     * EXPECT: no warning on persistTransaction(tok).
     *         definite warning on sendToGateway(cvv).
     */
    splitFlows() {
        def rawCard = this.getCardNumber();
        def tok     = this.tokenizeCard(rawCard);
        def cvv     = this.getCVV();
        this.persistTransaction(tok);
        this.sendToGateway(cvv);
    }

    /* Sources / Sanitizers / Sinks — bodies irrelevant. */
    getCardNumber() {
        def r = "4111111111111111";
        return r;
    }

    getCVV() {
        def r = "123";
        return r;
    }

    getBillingAddress() {
        def r = "addr";
        return r;
    }

    tokenizeCard(c) {
        return c;
    }

    normalizeAddress(a) {
        return a;
    }

    chargeCard(c) {
        return c;
    }

    sendToGateway(p) {
        return p;
    }

    persistTransaction(t) {
        return t;
    }
}