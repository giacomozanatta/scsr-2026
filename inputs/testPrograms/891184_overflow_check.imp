
/* This program simulates the behavior of a bank
 * The balance should be considered as a signed 8/16/32 bit variable
 * Depending on which variable size you consider, warnings may be triggered
 * by the operations executed in the complexOperation functions
 */

class Bank {
	balance;

	~Bank() {
		this.balance = 0;
	}

	deposit(amount) {
		if (amount >= 0) {
			this.balance = this.balance + amount;
		}
	}

	withdraw(amount) {
		if (amount >= 0) {
			this.balance = this.balance - amount;
		}
	}

}

class Main {
	bank;

	~Main() {
		this.bank = new Bank();
	}

	complexOperation1(x) {
		// Note: x is a useless param used to test how
		// loops and branches are handled by the checker
		def bank = this.bank;
		bank.deposit(120);
		bank.deposit(120);
		if (x > -50000) {
			bank.deposit(120);
		} else {
			def i = 100000;
			while (i>0) {
				bank.deposit(1);
				i = i - 1;
			}
		}
		return bank.balance;
	}

	complexOperation2() {
		def bank = this.bank;
		bank.deposit(2000111222);
		for (def i = 0; i < 35000; i = i + 1) {
			def cut = bank.balance % 11;
			if (cut != 0) {
			    def y = cut * 123456;
				bank.withdraw(y);
			} else {
				bank.withdraw(13);
			}
		}
		return bank.balance;
	}

}